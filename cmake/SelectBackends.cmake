macro(asl_backend family source initializer)
    cmake_parse_arguments(BACKEND "" "" "SUPPORT" ${ARGN})
    list(APPEND ASL_KNOWN_BACKENDS "${family}")
    set(ASL_BACKEND_${family}_SOURCES "${source}" ${BACKEND_SUPPORT})
    set(ASL_BACKEND_${family}_INIT "${initializer}")
endmacro()

include("${CMAKE_CURRENT_LIST_DIR}/Backends.cmake")
set(ASL_CPU_BACKENDS "ALL" CACHE STRING "CPU backend families to register (ALL, NONE, or a semicolon-separated list)")
set_property(CACHE ASL_CPU_BACKENDS PROPERTY STRINGS ALL ${ASL_KNOWN_BACKENDS})

if(ASL_CPU_BACKENDS STREQUAL "ALL")
    set(ASL_ENABLED_BACKENDS ${ASL_KNOWN_BACKENDS})
else()
    set(ASL_ENABLED_BACKENDS NONE ${ASL_CPU_BACKENDS})
    foreach(family IN LISTS ASL_ENABLED_BACKENDS)
        if(NOT family IN_LIST ASL_KNOWN_BACKENDS)
            message(FATAL_ERROR "Unknown ASL CPU backend '${family}'. Available families: ${ASL_KNOWN_BACKENDS}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES ASL_ENABLED_BACKENDS)
endif()

# Iterate the manifest rather than the selection to preserve registration order.
set(registry "/* Generated by CMake; do not edit. */\n#include \"backend_registry.h\"\n")
set(registrations "")
foreach(family IN LISTS ASL_KNOWN_BACKENDS)
    if(family IN_LIST ASL_ENABLED_BACKENDS)
        list(APPEND ASL_BACKEND_SOURCES ${ASL_BACKEND_${family}_SOURCES})
        string(APPEND registry "void ${ASL_BACKEND_${family}_INIT}(void);\n")
        string(APPEND registrations "    ${ASL_BACKEND_${family}_INIT}();\n")
    endif()
endforeach()
list(REMOVE_DUPLICATES ASL_BACKEND_SOURCES)
string(APPEND registry "\nvoid asl_register_backends(void) {\n${registrations}}\n")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/backend_registry.c" CONTENT "${registry}" @ONLY)
message(STATUS "ASL CPU backends: ${ASL_ENABLED_BACKENDS}")
