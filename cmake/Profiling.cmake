# Keep profiling opt-in and use separate build directories for timing and tracing.
set(ASL_PROFILE "OFF" CACHE STRING "Profiling mode: OFF, SAMPLE, or GPROF")
set_property(CACHE ASL_PROFILE PROPERTY STRINGS OFF SAMPLE GPROF)
if(NOT ASL_PROFILE MATCHES "^(OFF|SAMPLE|GPROF)$")
    message(FATAL_ERROR "ASL_PROFILE must be OFF, SAMPLE, or GPROF")
endif()
if(ASL_PROFILE STREQUAL "GPROF" AND NOT CMAKE_C_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "ASL_PROFILE=GPROF requires GCC (including MinGW GCC)")
endif()
if(NOT ASL_PROFILE STREQUAL "OFF")
    if(MSVC)
        add_compile_options(/Zi)
        add_link_options(/DEBUG /INCREMENTAL:NO)
    elseif(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        add_compile_options(-g -fno-omit-frame-pointer)
    else()
        message(FATAL_ERROR "Profiling flags are not defined for this compiler")
    endif()
endif()
if(ASL_PROFILE STREQUAL "GPROF")
    add_compile_options(-pg)
    add_link_options(-pg)
    if(WIN32)
        # MinGW gmon records absolute addresses; gprof reads the PE image base.
        # Disable relocation only in this diagnostic build so symbols match.
        add_link_options(-Wl,--disable-dynamicbase -Wl,--disable-high-entropy-va)
    endif()
endif()
