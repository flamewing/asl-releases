file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(op BRU BRF BRT)
    if(op STREQUAL BRU)
        set(prefix " bru ")
        set(column 6)
    else()
        set(prefix " ${op} r0,")
        set(column 9)
    endif()
    check_diagnostic(overflow_${op} XS1 "${prefix}4294967297" 1320 "4294967297 > 4294967295" 3 ${column})
    check_diagnostic(undefined_${op} XS1 "${prefix}missing" 1010 "symbol undefined" 3 ${column})
    check_diagnostic(expression_${op} XS1 "${prefix}1/0" 1310 "division by 0" 3 "")
endforeach()
check_bytes(original XS1 " addi r0,r1,0\n addi r11,r10,11\n ashri r0,r1,11\n getr r11,11\n bru 128\n bru 262\n brf r0,12\n bru r11" "0490bb9687f8ec97ef803a73010f3b73037ceb2f")
foreach(op BRU BRF BRT)
    if(op STREQUAL BRU)
        set(prefix " bru ")
    else()
        set(prefix " ${op} r0,")
    endif()
    if(op STREQUAL BRU)
        set(column 6)
    else()
        set(column 9)
    endif()
    check_diagnostic(signed_boundary_${op} XS1 "${prefix}2147483650" 1370 "branch displacement 2147483646 outside [-131070,131068] (PC base 0x4)" 3 ${column})
endforeach()
foreach(op ADDI EQI LDWI SHLI SHRI STWI SUBI ASHRI LDAWBI OUTPW INPW LDAWFI)
    string(LENGTH "${op}" op_length)
    math(EXPR column "${op_length} + 9")
    foreach(value 12 15)
        check_diagnostic(immediate_${op}_${value} XS1 " ${op} r0,r1,${value}" 1320 "immediate value ${value} outside [0,11]" 3 ${column})
    endforeach()
endforeach()
foreach(op CHKCTI MKMSKI SEXTI GETR OUTCTI ZEXTI)
    string(LENGTH "${op}" op_length)
    math(EXPR column "${op_length} + 6")
    check_diagnostic(immediate_${op} XS1 " ${op} r0,12" 1320 "immediate value 12 outside [0,11]" 3 ${column})
endforeach()
foreach(op BRU BRF BRT)
    if(op STREQUAL BRU)
        set(prefix " bru ")
        set(column 6)
    else()
        set(prefix " ${op} r0,")
        set(column 9)
    endif()
    check_diagnostic(long_upper_${op} XS1 "${prefix}131074" 1370 "branch displacement 131070 outside [-131070,131068] (PC base 0x4); must be a multiple of 2" 3 ${column})
    check_diagnostic(long_lower_${op} XS1 " org 131068\n${prefix}0" 1370 "branch displacement -131072 outside [-131070,131068] (PC base 0x20000)" 4 ${column})
    check_diagnostic(odd_${op} XS1 "${prefix}3" 1325 "branch displacement 1 must be a multiple of 2 (PC base 0x2)" 3 ${column})
endforeach()
check_diagnostic(instruction_odd XS1 " org 1\n clre" 180 "instruction address 0x1 must be aligned to 2 bytes" 4 2 0)
check_bytes(short_upper XS1 " bru 128" "3f73")
check_bytes(short_lower XS1 " org 124\n bru 0" "3f77")
check_bytes(long_transition XS1 " bru 130" "000f3f73")
check_bytes(long_upper XS1 " bru 131072" "ff0f3e73")
check_bytes(long_lower XS1 " org 131066\n bru 0" "ff0f3f77")
check_bytes(zero XS1 " bru 2" "0073")
check_bytes(forward_branch XS1 " bru target\n clre\ntarget: clre" "0173ed07ed07")
check_bytes(forward_immediate XS1 " addi r0,r1,value\nvalue equ 11" "8790")
