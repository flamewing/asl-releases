check_diagnostic(invalid_destination_primary 77230 " ldi invalid,missing" 1445 "invalid register" 3 6)
check_diagnostic(undefined_immediate 77230 " ldi wr0,missing" 1010 "symbol undefined" 3 10)
check_diagnostic(overflow_immediate 77230 " ldi wr0,1000000h" 1320 "range overflow" 3 10)
check_bytes(reject_destination 77230 " expect 1445\n ldi invalid,1\n endexpect\n nop" "00000000")
check_bytes(reject_destination_parallel 77230 " expect 1445\n ldi invalid,1 mov wr0,rp\n endexpect\n nop" "00000000")
check_bytes(reject_immediate 77230 " expect 1320\n ldi wr0,1000000h\n endexpect\n nop" "00000000")
check_bytes(original 77230 " ldi wr0,123456h\n ldi rp,-1\n ldi wr7,0ffffffh\n mov wr0,stx\n add wr7,ram1\n inc wr0" "d08a46e2e1ffffdff7fffffff0000000007c008000000008")

foreach(op SETSVL SETSVR)
    foreach(value 47 63)
        check_diagnostic(shift_${op}_${value} 77230 " ${op} ${value}" 1320 "${op} argument ${value} outside [0,46]" 3 9)
        check_bytes(reject_shift_${op}_${value} 77230 " expect 1320\n ${op} ${value}\n endexpect\n nop" "00000000")
    endforeach()
    check_diagnostic(shift_type_${op} 77230 " ${op} 64" 1320 "range overflow" 3 9)
    check_diagnostic(shift_undefined_${op} 77230 " ${op} missing" 1010 "symbol undefined" 3 9)
endforeach()
check_bytes(shift_original 77230 " setsvl 0\n setsvl 46\n setsvr 0\n setsvr 46" "0000c0050000d7050000e0050000f705")
check_bytes(forward_shift 77230 " setsvl amount\n setsvr amount\namount equ 46" "0000d7050000f705")

set(destinations "NON, RP, PSW0, PSW1, SVR, SR, LC, STK, LKR0, KLR1, TRE, TR, AR, SO, DR, DRS, WR0, WR1, WR2, WR3, WR4, WR5, WR6, WR7, RAM0, RAM1, BP0, BP1, IX0, IX1, K, L")
set(sources "NON, RP, PSW0, PSW1, SVR, SR, LC, STX, M, ML, ROM, TR, AR, SI, DR, DRS, WR0, WR1, WR2, WR3, WR4, WR5, WR6, WR7, RAM0, RAM1, BP0, BP1, IX0, IX1, K, L")
check_diagnostic(mov_destination 77230 " mov stx,wr0" 1445 "operand must be ${destinations}" 3 6)
check_diagnostic(mov_source 77230 " mov wr0,stk" 1445 "operand must be ${sources}" 3 10)
check_diagnostic(ldi_destination_choices 77230 " ldi stx,1" 1445 "operand must be ${destinations}" 3 6)
foreach(op INC DEC ABS NOT NEG SHLC SHRC ROL ROR SHLM SHRM SHRAM CLR NORM CVT)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(alu1_${op} 77230 " ${op} rp" 1445 "operand must be WR0, WR1, WR2, WR3, WR4, WR5, WR6, WR7" 3 ${column})
endforeach()
foreach(op ADD SUB ADDC SUBC CMP AND OR XOR ADDF SUBF)
    string(LENGTH "${op}" length)
    math(EXPR destination "${length} + 3")
    math(EXPR source "${length} + 7")
    check_diagnostic(alu2_destination_${op} 77230 " ${op} rp,m" 1445 "operand must be WR0, WR1, WR2, WR3, WR4, WR5, WR6, WR7" 3 ${destination})
    check_diagnostic(alu2_source_${op} 77230 " ${op} wr0,rp" 1445 "operand must be IB, M, RAM0, RAM1" 3 ${source})
endforeach()
