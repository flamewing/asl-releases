file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

set(dest20 "@NON, @A, @B, @TR, @DP, @RP, @DR, @SR, @SOL, @SOM, @K, @KLR, @KLM, @L, @MEM")
set(dest25 "@NON, @A, @B, @TR, @DP, @RP, @DR, @SR, @SOL, @SOM, @K, @KLR, @KLM, @L, @TRB, @MEM")
foreach(cpu 7720 7725)
    if(cpu EQUAL 7720)
        set(dest "${dest20}")
    else()
        set(dest "${dest25}")
    endif()
    foreach(op LDI LD)
        string(LENGTH "${op}" op_length)
        math(EXPR column "${op_length} + 3")
        check_diagnostic(dest_${op}_${cpu} ${cpu} " ${op} @missing,0" 1445 "operand must be ${dest}" 3 ${column})
    endforeach()
    check_diagnostic(move_dest_${cpu} ${cpu} " op mov @missing,a" 1445 "operand must be ${dest}" 3 9)
    check_diagnostic(move_source_${cpu} ${cpu} " op mov @a,missing" 1445 "operand must be NON, A, B, TR, DP, RP, RO, SGN, DR, DRNF, SR, SIM, SIL, K, L, MEM" 3 12)
    foreach(op OR AND XOR SUB ADD SBB ADC CMP)
        string(LENGTH "${op}" op_length)
        math(EXPR column "${op_length} + 11")
        math(EXPR acc_column "${op_length} + 6")
        check_diagnostic(alu_source_${op}_${cpu} ${cpu} " op ${op} acca,missing" 1445 "operand must be RAM, IDB, M, N" 3 ${column})
        check_diagnostic(alu_acc_${op}_${cpu} ${cpu} " op ${op} accc,ram" 1445 "operand must be ACCA, ACCB" 3 ${acc_column})
    endforeach()
    foreach(op DEC INC SHR1 SHL1 SHL2 SHL4 XCHG)
        string(LENGTH "${op}" op_length)
        math(EXPR acc_column "${op_length} + 6")
        check_diagnostic(alu_acc_${op}_${cpu} ${cpu} " op ${op} accc" 1445 "operand must be ACCA, ACCB" 3 ${acc_column})
    endforeach()
    check_diagnostic(duplicate_move_${cpu} ${cpu} " op mov @a,a\n mov @b,b" 1355 "parallel operation already contains the MOV field" 4 2)
    check_diagnostic(duplicate_alu_${cpu} ${cpu} " op or acca,ram\n add accb,idb" 1355 "parallel operation already contains the ALU field" 4 2)
    check_diagnostic(duplicate_dpl_${cpu} ${cpu} " op DPINC\n dpdec" 1355 "parallel operation already contains the DPL field" 4 2)
    check_diagnostic(duplicate_dph_${cpu} ${cpu} " op M0\n m1" 1355 "parallel operation already contains the DPH field" 4 2)
    check_diagnostic(duplicate_rp_${cpu} ${cpu} " op RPDEC\n rpnop" 1355 "parallel operation already contains the RP field" 4 2)
    check_diagnostic(duplicate_ret_${cpu} ${cpu} " op RET\n ret" 1355 "parallel operation already contains the RET field" 4 2)
endforeach()
check_diagnostic(trb20 7720 " ldi @trb,0" 1445 "operand must be ${dest20}" 3 6)
check_bytes(original20 7720 " ldi @a,-1\n op mov @mem,a\n add accb,n\n dpinc\n m7\n rpdec\n ret" "e1ff5f001fdf3a00")
check_bytes(original25 7725 " ldi @trb,-1\n op mov @mem,a\n add accb,n\n dpinc\n mf\n rpdec\n ret" "ceffbf001fbf7500")
check_bytes(bare_lower20 7720 " op nop\n op dpinc\n op m1\n op rpdec\n op ret" "0000000000100000000200000001000000002000")
check_bytes(bare_upper20 7720 " OP NOP\n OP DPINC\n OP M1\n OP RPDEC\n OP RET" "0000000000100000000200000001000000002000")
check_bytes(bare_mixed25 7725 " Op NoP\n Op DpInC\n Op M1\n Op RpDeC\n Op ReT" "0000000000200000000200000001000000004000")
check_bytes(bare_upper25 7725 " OP NOP\n OP DPINC\n OP M1\n OP RPDEC\n OP RET" "0000000000200000000200000001000000004000")
check_diagnostic(bare_lower_conflict 7720 " op dpinc\n dpdec" 1355 "parallel operation already contains the DPL field" 4 2)
check_diagnostic(unknown_lower 7725 " op missing" 1200 "unknown instruction" 3 5)
