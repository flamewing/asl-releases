file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


set(cpu_names TI990/4 TI990/10 TI990/12 TMS9900 TMS9940 TMS9995 TMS99105 TMS99110)
foreach(cpu IN LISTS cpu_names)
    string(REPLACE "/" "_" tag "${cpu}")
    check_diagnostic(register_overflow_${tag} ${cpu} " mov 16,r0" 1320 "16 > 15" 3 6)
    check_diagnostic(register_undefined_${tag} ${cpu} " mov missing,r0" 1010 "symbol undefined" 3 6)
    check_diagnostic(destination_underflow_${tag} ${cpu} " mov r0,-1" 1315 "-1 < 0" 3 9)
    check_diagnostic(immediate_syntax_${tag} ${cpu} " mov #1,r0" 1020 "invalid symbol name" 3 6)
    check_diagnostic(bare_indirect_${tag} ${cpu} " mov *,r0" 1350 "allowed addressing forms: *R0..*R15 / *R0+..*R15+" 3 6)
    check_diagnostic(bare_increment_${tag} ${cpu} " mov *+,r0" 1350 "allowed addressing forms: *R0..*R15 / *R0+..*R15+" 3 6)
    check_bytes(reject_register_${tag} ${cpu} " expect 1320\n mov 16,r0\n endexpect\n word 1234h" "1234")
    check_bytes(reject_indirect_${tag} ${cpu} " expect 1350\n mov *+,r0\n endexpect\n word 1234h" "1234")
endforeach()
check_bytes(original TMS9900 " mov r1,r2\n mov *r1,r2\n mov *r1+,r2\n mov @100h,r2\n mov @100h(r1),r2" "c081c091c0b1c0a00100c0a10100")

foreach(cpu IN LISTS cpu_names)
    string(REPLACE "/" "_" tag "${cpu}")
    check_bytes(byte_partial_upper_${tag} ${cpu} " expect 1320\n byte 1,256,2\n endexpect\n word 1234h" "1234")
    check_bytes(byte_partial_lower_${tag} ${cpu} " expect 1320\n byte 1,-129,2\n endexpect\n word 1234h" "1234")
    check_bytes(byte_partial_string_${tag} ${cpu} " expect 1320\n byte 1,\"AB\",256\n endexpect\n word 1234h" "1234")
    check_bytes(byte_original_${tag} ${cpu} " byte 1,2,-128,255,\"AB\"" "010280ff4142")
endforeach()

set(branch_ops JEQ JGT JH JHE JL JLE JLT JMP JNC JNE JNO JOC JOP)
set(branch_codes 13 15 1b 14 1a 12 11 10 17 16 19 18 1c)
foreach(index RANGE 0 12)
    list(GET branch_ops ${index} op)
    list(GET branch_codes ${index} code)
    check_bytes(forward_branch_${op} TMS9900 " org 256\n ${op} target+1000\ntarget equ -740" "${code}01")
    check_bytes(forward_odd_${op} TMS9900 " org 256\n ${op} target+1001\ntarget equ -741" "${code}01")
endforeach()
foreach(cpu IN LISTS cpu_names)
    string(REPLACE "/" "_" tag "${cpu}")
    check_bytes(forward_cpu_${tag} ${cpu} " org 256\n jmp target+1001\ntarget equ -741" "1001")
endforeach()
check_bytes(forward_srj TI990/12 " org 256\n srj target+1000,r1\ntarget equ -738" "0c0c1101")
check_bytes(forward_arj TI990/12 " org 256\n arj target+1001,r1\ntarget equ -739" "0c0d1101")

foreach(cpu IN LISTS cpu_names)
    if(cpu STREQUAL "TI990/12")
        continue()
    endif()
    string(REPLACE "/" "_" tag "${cpu}")
    foreach(op SRJ ARJ)
        check_diagnostic(unsupported_${op}_${tag} ${cpu} " ${op} 6,r1" 1500 "instruction not supported" 3 2)
        check_bytes(reject_${op}_${tag} ${cpu} " expect 1500\n ${op} 6,r1\n endexpect\n word 1234h" "1234")
    endforeach()
endforeach()
check_bytes(srj_original TI990/12 " srj 6,r1" "0c0c1101")
check_bytes(arj_original TI990/12 " arj 6,r1" "0c0d1101")

foreach(cpu IN LISTS cpu_names)
    string(REPLACE "/" "_" tag "${cpu}")
    check_diagnostic(index_r0_${tag} ${cpu} " mov @100h(r0),r1" 1445 "operand must be R1..R15" 3 12)
    check_diagnostic(code_alignment_${tag} ${cpu} " padding off\n org 1\n mov r0,r1" 180 "instruction address 0x1 must be aligned to 2 bytes" 5 2 0)
    check_diagnostic(byte_upper_${tag} ${cpu} " byte 256" 1320 "BYTE argument 256 outside [-128,255]" 3 7)
    check_diagnostic(byte_lower_${tag} ${cpu} " byte -129" 1320 "BYTE argument -129 outside [-128,255]" 3 7)
    check_bytes(padding_on_${tag} ${cpu} " padding on\n org 1\n mov r0,r1" "00c040")
    check_bytes(word_odd_bytes_${tag} ${cpu} " mov @101h,r1" "c0600101")
    check_bytes(byte_odd_address_${tag} ${cpu} " movb @101h,r1" "d0600101")
    if(cpu STREQUAL "TMS99105" OR cpu STREQUAL "TMS99110")
        check_diagnostic(rtwp_reserved_${tag} ${cpu} " rtwp 3" 1985 "RTWP value 3 not allowed; accepted values: 0, 1, 2, 4" 3 7)
        check_diagnostic(rtwp_upper_${tag} ${cpu} " rtwp 5" 1320 "RTWP value 5 not allowed; accepted values: 0, 1, 2, 4" 3 7)
        check_bytes(rtwp_variants_${tag} ${cpu} " rtwp\n rtwp 0\n rtwp 1\n rtwp 2\n rtwp 4" "03800380038103820384")
    else()
        check_diagnostic(rtwp_zero_only_${tag} ${cpu} " rtwp 1" 1320 "RTWP value 1 not allowed; accepted values: 0" 3 7)
        check_bytes(rtwp_original_${tag} ${cpu} " rtwp\n rtwp 0" "03800380")
    endif()
endforeach()
foreach(op IN LISTS branch_ops)
    string(LENGTH "${op}" op_length)
    math(EXPR branch_column "${op_length}+3")
    check_diagnostic(branch_odd_${op} TMS9900 " ${op} 3" 1375 "branch displacement 1 must be a multiple of 2 (PC base 0x2)" 3 ${branch_column})
    check_diagnostic(branch_upper_${op} TMS9900 " ${op} 258" 1370 "branch displacement 256 outside [-256,254] (PC base 0x2); must be a multiple of 2" 3 ${branch_column})
    check_diagnostic(branch_lower_${op} TMS9900 " org 256\n ${op} 0" 1370 "branch displacement -258 outside [-256,254] (PC base 0x102); must be a multiple of 2" 4 ${branch_column})
endforeach()
foreach(op SRJ ARJ)
    check_diagnostic(long_branch_odd_${op} TI990/12 " ${op} 5,r1" 1375 "branch displacement 1 must be a multiple of 2 (PC base 0x4)" 3 6)
    check_diagnostic(long_branch_upper_${op} TI990/12 " ${op} 260,r1" 1370 "branch displacement 256 outside [-256,254] (PC base 0x4); must be a multiple of 2" 3 6)
    check_diagnostic(cpu_detail_${op} TMS9900 " ${op} 6,r1" 1500 "supported only by TI990/12" 3 2)
endforeach()
foreach(cpu TI990/12 TMS99105 TMS99110)
    string(REPLACE "/" "_" tag "${cpu}")
    foreach(op TMB TCMB TSMB)
        string(LENGTH "${op}" op_length)
        math(EXPR operand_column "${op_length}+3")
        check_diagnostic(no_increment_${op}_${tag} ${cpu} " ${op} *r1+,0" 1350 "allowed addressing forms: R0..R15 / *Rn / @address / @displacement(R1..R15)" 3 ${operand_column})
    endforeach()
endforeach()
check_diagnostic(cpu_group TMS9900 " am r0,r1" 1500 "supported only by TI990/12 or TMS99105 or TMS99110" 3 2)
check_bytes(branch_endpoints TMS9900 " org 256\n jmp 2\n jmp 514" "1080107f")
