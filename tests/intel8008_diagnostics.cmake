file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu 8008 8008NEW)
    foreach(op JP J CALL RET)
        string(LENGTH "${op}" op_length)
        math(EXPR condition_column "${op_length}+3")
        if(op STREQUAL "RET")
            set(target "")
        else()
            set(target ",0")
        endif()
        check_diagnostic(condition_${cpu}_${op} ${cpu} " z80syntax on\n ${op} bad${target}" 1360 "operand must be NC / NZ / P / PO / C / Z / M / PE" 4 ${condition_column})
        check_bytes(reject_condition_${cpu}_${op} ${cpu} " z80syntax on\n expect 1360\n ${op} bad${target}\n endexpect\n db 18" "12")
    endforeach()
    check_bytes(conditions_original_${cpu} ${cpu} " z80syntax on\n jp nc,0\n jp nz,0\n jp p,0\n jp po,0\n jp c,0\n jp z,0\n jp m,0\n jp pe,0\n ret nc\n ret nz\n ret p\n ret po\n ret c\n ret z\n ret m\n ret pe" "400000480000500000580000600000680000700000780000030b131b232b333b")
    check_bytes(call_original_${cpu} ${cpu} " z80syntax on\n call c,256\n j z,256\n ret" "62000168000107")
endforeach()

foreach(cpu 8008 8008NEW)
    foreach(dest A B C D E H L)
        foreach(src BC DE HL)
            check_diagnostic(ld_pair_${cpu}_${dest}_${src} ${cpu} " z80syntax exclusive\n ld ${dest},${src}" 1350 "addressing mode not allowed here" 4 7)
            check_bytes(reject_ld_pair_${cpu}_${dest}_${src} ${cpu} " z80syntax exclusive\n expect 1350\n ld ${dest},${src}\n endexpect\n db 18" "12")
        endforeach()
    endforeach()
    check_bytes(ld_original_${cpu} ${cpu} " z80syntax exclusive\n ld a,b\n ld a,(hl)\n ld a,255\n ld (hl),a\n ld (hl),255\n ld bc,4660\n ld de,4660\n ld hl,4660\n db 18" "c1c706fff83eff0e1216341e1226342e12363412")
endforeach()
