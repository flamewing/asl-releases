file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(ld_dest COP87L84 " ld [x],a" 1350 "allowed addressing forms: A, [B], [B+], [B-], expr" 3 5)
check_diagnostic(ld_source COP87L84 " ld a,a" 1350 "allowed addressing forms: [B], [B+], [B-], [X], [X+], [X-], expr, #expr" 3 7)
check_diagnostic(ld_immediate COP87L84 " ld [b],a" 1350 "allowed addressing forms: #expr" 3 9)
foreach(op CLR INC DEC DCOR RRC RLC SWAP POP PUSH)
    string(LENGTH "${op}" length)
    math(EXPR column "${length}+3")
    check_diagnostic(acc_${op} COP87L84 " ${op} [b]" 1350 "allowed addressing forms: A" 3 "${column}")
endforeach()
foreach(op ADD ADC SUBC AND OR XOR IFGT)
    string(LENGTH "${op}" length)
    math(EXPR column "${length}+5")
    check_diagnostic(alu_${op} COP87L84 " ${op} a,[x]" 1350 "allowed addressing forms: [B], expr, #expr" 3 "${column}")
endforeach()
check_diagnostic(ifbne COP87L84 " ifbne 1" 1350 "this operand requires an immediate value with # before the expression" 3 8)
check_diagnostic(drsz COP87L84 " drsz 239" 1315 "DRSZ argument 239 outside [240,255]" 3 7)
check_diagnostic(jp_upper COP87L84 " jp 33" 1370 "branch displacement 32 outside [-32,31] (PC base 0x1)" 3 5)
check_diagnostic(jp_lower COP87L84 " org 32\n jp 0" 1370 "branch displacement -33 outside [-32,31] (PC base 0x21)" 4 5)
check_diagnostic(undefined COP87L84 " jp missing" 1010 "symbol undefined" 3 5)
check_bytes(original COP87L84 " ld a,#255\n ld a,[b+]\n ld [b],#1\n x a,[x-]\n ifbne #15\n drsz 240\n drsz -1\n jp 38" "98ffaa9e01b34fc0cf1c")
check_bytes(jp_upper_edge COP87L84 " jp 32" "1f")
check_bytes(jp_lower_edge COP87L84 " org 31\n jp 0" "e0")
check_bytes(jp_wrapped COP87L84 " jp 65535" "fe")
check_bytes(jp_zero COP87L84 " jp 1" "b8")
check_bytes(forward COP87L84 " jp target\n nop\ntarget: nop" "01b8b8")
