file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(op XPAL XPAH XPPC)
    check_diagnostic(register_size_${op} SC/MP " ${op} e" 1130 "invalid operand size" 3 7)
    check_diagnostic(register_range_${op} SC/MP " ${op} 4" 1320 "4 > 3" 3 7)
    check_diagnostic(register_undefined_${op} SC/MP " ${op} missing" 1010 "symbol undefined" 3 7)
    check_bytes(reject_register_${op} SC/MP " expect 1130\n ${op} e\n endexpect\n nop" "08")
endforeach()
check_diagnostic(js_register_size SC/MP " js e,0x1234" 1130 "invalid operand size" 3 5)
check_diagnostic(js_register_range SC/MP " js 4,0x1234" 1320 "4 > 3" 3 5)
check_diagnostic(js_register_undefined SC/MP " js missing,0x1234" 1010 "symbol undefined" 3 5)
check_bytes(reject_js_register SC/MP " expect 1130\n js e,0x1234\n endexpect\n nop" "08")
check_bytes(original SC/MP " xpal p0\n xpah p3\n xppc pc\n js p1,0x1234\n ld e(p1)\n ld @1(p2)\n jmp -128(p0)" "30373cc41235c433313dc180c6019080")

foreach(pair "JMP:90" "JP:94" "JZ:98" "JNZ:9c" "LD:c0" "ST:c8" "AND:d0" "OR:d8" "XOR:e0" "DAD:e8" "ADD:f0" "CAD:f8" "ILD:a8" "DLD:b8")
    string(REPLACE ":" ";" fields "${pair}")
    list(GET fields 0 op)
    list(GET fields 1 opcode)
    if(op MATCHES "^J")
        set(target -741)
    else()
        set(target -742)
    endif()
    check_bytes(forward_${op} SC/MP " org 256\n ${op} target+1000\ntarget equ ${target}" "${opcode}01")
    check_diagnostic(resolved_far_${op} SC/MP " ${op} target+1000\ntarget equ 0" 1330 "distance too big" 3 "")
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(undefined_${op} SC/MP " ${op} target+1000" 1010 "symbol undefined" 3 ${column})
endforeach()
check_bytes(forward_label SC/MP " org 256\n jmp target\ntarget: nop" "900008")
check_bytes(page_wrap SC/MP " org 4094\n jmp 4095" "90ff")
