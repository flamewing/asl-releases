file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu TMS70C00 TMS70C20 TMS70C40 TMS70CT20 TMS70CT40 TMS70C02 TMS70C42 TMS70C82 TMS70C08 TMS70C48)
    check_bytes(forward_regular_${cpu} ${cpu} " org 256\n jmp target+1000\ntarget equ -741" "e001")
    check_bytes(forward_bit_${cpu} ${cpu} " org 256\n btjo b,a,target+1000\ntarget equ -741" "6601")
    check_bytes(forward_register_bit_${cpu} ${cpu} " org 256\n btjo #1,r2,target+1000\ntarget equ -739" "76010201")
    check_bytes(forward_port_bit_${cpu} ${cpu} " org 256\n btjop #1,p1,target+1000\ntarget equ -739" "a6010101")
    check_bytes(forward_djnz_${cpu} ${cpu} " org 256\n djnz a,target+1000\ntarget equ -741" "ba01")
    check_bytes(forward_register_djnz_${cpu} ${cpu} " org 256\n djnz r2,target+1000\ntarget equ -740" "da0201")
    check_diagnostic(resolved_far_${cpu} ${cpu} " jmp target+1000\ntarget equ 0" 1370 "branch displacement 998 outside [-128,127] (PC base 0x2)" 3 6)
    check_diagnostic(undefined_regular_${cpu} ${cpu} " jmp target+1000" 1010 "symbol undefined" 3 6)
    check_diagnostic(undefined_bit_${cpu} ${cpu} " btjo b,a,target+1000" 1010 "symbol undefined" 3 11)
    check_diagnostic(undefined_djnz_${cpu} ${cpu} " djnz a,target+1000" 1010 "symbol undefined" 3 9)
endforeach()
check_bytes(original TMS70C00 " org 256\n jmp 259\n nop\n nop\n btjo b,a,263\n nop\n nop\n djnz a,267\n nop\n nop" "e001000066010000ba010000")
foreach(op JMP JC JEQ JHS JL JN JNC JNE JNZ JP JPZ JZ JLT JGT JGE)
    string(LENGTH "${op}" op_length)
    math(EXPR column "${op_length} + 3")
    check_diagnostic(upper_${op} TMS70C00 " ${op} 130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 ${column})
    check_diagnostic(lower_${op} TMS70C00 " org 127\n ${op} 0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 ${column})
endforeach()
foreach(op BTJO BTJZ)
    check_diagnostic(bit_short_${op} TMS70C00 " ${op} b,a,130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 11)
    check_diagnostic(bit_register_${op} TMS70C00 " ${op} #1,r2,132" 1370 "branch displacement 128 outside [-128,127] (PC base 0x4)" 3 13)
endforeach()
foreach(op BTJOP BTJZP)
    check_diagnostic(bit_port_${op} TMS70C00 " ${op} #1,p1,132" 1370 "branch displacement 128 outside [-128,127] (PC base 0x4)" 3 14)
endforeach()
check_diagnostic(djnz_acc TMS70C00 " djnz a,130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 9)
check_diagnostic(djnz_register TMS70C00 " djnz r2,131" 1370 "branch displacement 128 outside [-128,127] (PC base 0x3)" 3 10)
check_diagnostic(base_register TMS70C00 " br 1234h(x)" 1445 "operand must be B" 3 11)
check_diagnostic(acc_mask TMS70C00 " tst r2" 1350 "allowed addressing forms: A, B" 3 6)
check_diagnostic(port_mask TMS70C00 " movp a,r2" 1350 "allowed addressing forms: A, B, P0..P255, expr (256..511)" 3 9)
check_diagnostic(jump_mask TMS70C00 " br #1" 1350 "allowed addressing forms: A, B, expr, @expr, expr(B), @expr(B), *expr" 3 5)
foreach(value 24 31)
    check_diagnostic(trap_${value} TMS70C00 " trap ${value}" 1320 "TRAP argument ${value} outside [0,23]" 3 7)
endforeach()
check_bytes(operand_original TMS70C00 " mov %255,a\n mov r255,b\n movp #1,p255\n movd #1234h,r2\n br 1234h(b)\n trap 23" "22ff32ffa201ff88123402ac1234e8")
check_bytes(upper_edge TMS70C00 " jmp 129" "e07f")
check_bytes(lower_edge TMS70C00 " org 126\n jmp 0" "e080")
check_bytes(wrap TMS70C00 " jmp 65535" "e0fd")
check_bytes(trap_edges TMS70C00 " trap 0\n trap 23" "ffe8")
check_bytes(imm_aliases TMS70C00 " mov #1,a\n mov %1,a" "22012201")
