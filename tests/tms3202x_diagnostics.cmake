file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu 320C25 320C26 320C28)
    foreach(op SST SST1)
        string(LENGTH "${op}" length)
        math(EXPR column "${length}+3")
        foreach(value 128 255 -1)
            if(value EQUAL -1)
                set(byte 255)
            else()
                set(byte "${value}")
            endif()
            check_diagnostic(page_${cpu}_${op}_${value} ${cpu} " ${op} ${value}" 1320 "${op} argument ${byte} outside [0,127]" 3 "${column}")
        endforeach()
    endforeach()
    foreach(op ADD LAC SACH SACL SUB BIT)
        string(LENGTH "${op}" length)
        math(EXPR column "${length}+5")
        if(op STREQUAL "SACH" OR op STREQUAL "SACL")
            set(maximum 7)
        else()
            set(maximum 15)
        endif()
        foreach(count -8 -1)
            check_diagnostic(shift_${cpu}_${op}_${count} ${cpu} " ${op} 0,${count}" 1380 "${op} argument ${count} outside [0,${maximum}]" 3 "${column}")
        endforeach()
        if(maximum EQUAL 7)
            check_diagnostic(shift_${cpu}_${op}_8 ${cpu} " ${op} 0,8" 1380 "${op} argument 8 outside [0,7]" 3 "${column}")
        endif()
    endforeach()
    set(forms "allowed addressing forms: *-, *+, *BR0-, *0-, *AR0-, *0+, *AR0+, *BR0+, *")
    check_diagnostic(norm_${cpu} ${cpu} " norm 0" 1350 "${forms}" 3 7)
    foreach(op B BANZ BBNZ BBZ BC BGEZ BGZ BIOZ BLEZ BLZ BNC BNV BNZ BV BZ CALL)
        string(LENGTH "${op}" length)
        math(EXPR column "${length}+5")
        check_diagnostic(branch_${cpu}_${op} ${cpu} " ${op} 0,0" 1350 "${forms}" 3 "${column}")
    endforeach()
    check_bytes(original_${cpu} ${cpu} " sst 127\n sst 256\n sst1 0\n sach 0,7\n norm *-\n b 1,*+" "7f7800780079006f92cea0ff0100")
endforeach()
check_diagnostic(indirect_contract_first 320C25 " norm missing" 1350 "${forms}" 3 7)
check_diagnostic(undefined 320C25 " sst missing" 1010 "symbol undefined" 3 6)
check_diagnostic(shift_undefined 320C25 " sach 0,missing" 1010 "symbol undefined" 3 9)
check_bytes(forward 320C25 " sst address\naddress equ 127" "7f78")
