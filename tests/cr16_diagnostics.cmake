file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()





foreach(cpu CR16A CR16B)
    check_bytes(load_wrong_register_noemit_${cpu} ${cpu} " expect 1350\n loadw 0(r0),0(r1)\n endexpect\n .word 0x1234" "3412")
    check_bytes(store_wrong_register_noemit_${cpu} ${cpu} " expect 1350\n storw 0(r1),0(r0)\n endexpect\n .word 0x1234" "3412")
    check_bytes(original_load_store_${cpu} ${cpu} " movw r1,r2\n loadw 0(r2),r1\n storw r1,0(r2)" "437824a024e0")
endforeach()

foreach(cpu CR16A CR16B)
    check_bytes(forward_destination_${cpu} ${cpu} " movw r1,alias\nalias reg r2" "4378")
    check_bytes(forward_base_${cpu} ${cpu} " loadw 0(alias),r1\nalias reg r2" "24a0")
    check_bytes(forward_two_registers_${cpu} ${cpu} " movxb source,dest\nsource reg r1\ndest reg r2" "4268")
    check_bytes(forward_cpu_register_${cpu} ${cpu} " lpr alias,psr\nalias reg r2" "2470")
    check_bytes(forward_base_pair_${cpu} ${cpu} " loadw 0(high,low),r1\nhigh reg r3\nlow reg r2" "25b80000")
    check_diagnostic(undefined_base_${cpu} ${cpu} " loadw 0(missing),r1" 1445 "missing" 3 10)
    check_diagnostic(undefined_destination_${cpu} ${cpu} " movw r1,missing" 1445 "missing" 3 10)
    check_bytes(nonregister_noemit_${cpu} ${cpu} "value equ 1\n expect 1147\n movw r1,value\n endexpect\n .word 0x1234" "3412")
endforeach()
check_bytes(forward_jump_cr16a CR16A " jump alias\nalias reg r2" "c555")
check_bytes(forward_jump_cr16b CR16B " jump (high,low)\nhigh reg r3\nlow reg r2" "c517")

foreach(cpu CR16A CR16B)
    check_diagnostic(forward_nonadjacent_pair_${cpu} ${cpu} " loadw 0(high,low),r1\nhigh reg r4\nlow reg r2" 1350 "addressing mode not allowed here" 3 8)
endforeach()
