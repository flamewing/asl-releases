file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu NS32016 NS32332 NS32532)
    foreach(scale B W D Q)
        check_diagnostic(index_wrong_type_${cpu}_${scale} ${cpu} " movd @100[f0:${scale}],r1" 1130 "invalid operand size" 3 12)
        check_bytes(reject_index_${cpu}_${scale} ${cpu} " expect 1130\n movd @100[f0:${scale}],r1\n endexpect\n db 18" "12")
    endforeach()
    check_bytes(scaled_original_${cpu} ${cpu} " movd @100[r1:b],r1\n movd @100[r2:w],r1\n movd @100[r3:d],r1\n movd @100[r4:q],r1" "57e0a9806457e8aa806457f0ab806457f8ac8064")
endforeach()

foreach(cpu NS32016 NS32332 NS32532)
    check_bytes(forward_index_${cpu} ${cpu} " movd @100[idx:b],r1\n movd @100[idx:w],r1\n movd @100[idx:d],r1\n movd @100[idx:q],r1\nidx reg r2" "57e0aa806457e8aa806457f0aa806457f8aa8064")
    check_bytes(forward_save_${cpu} ${cpu} " save [idx]\nidx reg r2" "6204")
    check_diagnostic(index_missing_${cpu} ${cpu} " movd @100[missing:b],r1" 1445 "invalid register" 3 12)
endforeach()

foreach(cpu NS32332 NS32532)
    foreach(target 700000000 -520093697)
        check_diagnostic(pc_overflow_${cpu}_${target} ${cpu} " movd ${target}(pc),r1" 1370 "jump distance too big" 3 7)
        check_bytes(reject_pc_${cpu}_${target} ${cpu} " expect 1370\n movd ${target}(pc),r1\n endexpect\n db 18" "12")
    endforeach()
    check_bytes(pc_original_${cpu} ${cpu} " movd 0(pc),r1\n movd 63(pc),r1\n movd 8191(pc),r1" "57d80057d83c57d89ff9")
    check_bytes(pc_forward_${cpu} ${cpu} " movd target(pc),r1\ntarget equ 0" "57d800")
endforeach()

foreach(cpu NS32016 NS32332 NS32532)
    foreach(op RET RETT RXP CXP ENTER)
        set(operand "1.5")
        set(column 6)
        if(op STREQUAL "RETT")
            set(column 7)
        elseif(op STREQUAL "ENTER")
            set(operand "[r0],1.5")
            set(column 13)
        endif()
        string(TOLOWER "${op}" mnemonic)
        check_diagnostic(control_primary_${cpu}_${op} ${cpu} " ${mnemonic} ${operand}" 1133 "expected integer or string" 3 ${column})
        check_bytes(control_reject_${cpu}_${op} ${cpu} " expect 1133\n ${mnemonic} ${operand}\n endexpect\n db 18" "12")
    endforeach()
    check_diagnostic(enter_range_${cpu} ${cpu} " enter [r0],-520093697" 1320 "range overflow" 3 13)
    check_bytes(control_original_${cpu} ${cpu} " ret\n ret 63\n rett -64\n rxp 0\n cxp 63" "1200123f42403200223f")
    check_bytes(control_forward_${cpu} ${cpu} " ret amount\n rett amount\n rxp amount\n cxp amount\namount equ 0" "1200420032002200")
    check_bytes(enter_original_${cpu} ${cpu} " enter [r0],0\n enter [r2,r7],63\n enter [r2],-64" "82010082843f820440")
    check_bytes(enter_forward_${cpu} ${cpu} " enter [r0],amount\namount equ 0" "820100")
endforeach()

foreach(cpu NS32016 NS32332 NS32532)
    check_diagnostic(list_format_${cpu} ${cpu} " save r0" 1410 "[R0..R7, ...]" 3 7)
    check_diagnostic(list_member_${cpu} ${cpu} " save [sp]" 1445 "R0..R7" 3 8)
    check_diagnostic(index_member_${cpu} ${cpu} " movd @100[sp:b],r1" 1445 "R0..R7" 3 12)
    check_diagnostic(nested_member_${cpu} ${cpu} " movd 1(2(r0)),r1" 1445 "FP, SP or SB" 3 11)
    check_diagnostic(reg_type_${cpu} ${cpu} " movd f0,r1" 1130 "register f0 has type F32; required I32" 3 7)
    check_diagnostic(float_type_${cpu} ${cpu} " fpu ns32081\n movlf l0,l2" 1130 "register l2 has type F64; required F32" 4 11)
    check_diagnostic(pair_int_${cpu} ${cpu} " meid r0,r1" 1760 "R0/R2/R4/R6" 3 10)
    check_diagnostic(pair_float_${cpu} ${cpu} " fpu ns32081\n movlf l1,f2" 1760 "F0/F2/F4/F6 or L0/L2/L4/L6" 4 8)
    check_diagnostic(control_reg_${cpu} ${cpu} " lprd missing,r0" 1445 "UPSR, DCR, BPC, DSR, CAR, FP, SP, SB, USP, CFG, PSR, INTBASE, MOD" 3 7)
endforeach()
