file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()





foreach(pair EQ:d8:2 Z:d8:2 NE:d9:2 NZ:d9:2 CS:da:2 LT:da:2 CC:db:2 GE:db:2 LE:dc:2 GT:dd:2 M:e8d0:3 P:e8d1:3 SLT:e8d2:3 SGE:e8d3:3 SLE:e8d4:3 SGT:e8d5:3 VS:e8d6:3 VC:e8d7:3 T:de:2 F:df:2)
    string(REPLACE ":" ";" parts "${pair}")
    list(GET parts 0 cond)
    list(GET parts 1 code)
    list(GET parts 2 size)
    math(EXPR value "${size} - 1000")
    check_bytes(forward_jr_${cond} TLCS-870/C " jr ${cond},target+1000\ntarget equ ${value}" "${code}00")
    math(EXPR value "${size} + 1000")
    check_bytes(forward_jr_lower_${cond} TLCS-870/C " jr ${cond},target-1000\ntarget equ ${value}" "${code}00")
endforeach()
foreach(pair T:80 F:a0)
    string(REPLACE ":" ";" parts "${pair}")
    list(GET parts 0 cond)
    list(GET parts 1 code)
    check_bytes(forward_jrs_${cond} TLCS-870/C " jrs ${cond},target+1000\ntarget equ -998" "${code}")
    check_bytes(forward_jrs_lower_${cond} TLCS-870/C " jrs ${cond},target-1000\ntarget equ 1002" "${code}")
endforeach()
check_bytes(forward_jr TLCS-870/C " jr target+1000\ntarget equ -998" "fc00")
check_bytes(original_branches TLCS-870/C " jrs t,2\n jrs f,3\n jr 4\n jr eq,6" "80a0fc00d800")
check_diagnostic(jrs_final TLCS-870/C " jrs t,target\ntarget equ 1000" 1370 "jump distance too big" 3 "")
check_diagnostic(jr_final TLCS-870/C " jr target\ntarget equ 1000" 1370 "jump distance too big" 3 "")

foreach(pair upper:+256:1320 lower:-256:1315)
    string(REPLACE ":" ";" parts "${pair}")
    list(GET parts 0 tag)
    list(GET parts 1 value)
    list(GET parts 2 id)
    check_bytes(sp_range_noemit_${tag} TLCS-870/C " expect ${id}\n ld sp,sp${value}\n endexpect\n db 12h" "12")
endforeach()
check_bytes(sp_displacement_endpoints TLCS-870/C " ld sp,sp+255\n ld sp,sp-255\n ld sp,sp+0" "37ff3fff3700")
check_bytes(sp_displacement_forward TLCS-870/C " ld sp,sp-target\ntarget equ -255" "37ff")
