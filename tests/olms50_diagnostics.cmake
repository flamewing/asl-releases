file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu MSM5054 MSM5055 MSM5056 MSM6051 MSM6052)
    check_diagnostic(prefix_${cpu} ${cpu} " jmpio 12" 1350 "addressing mode not allowed here" 3 8)
    check_diagnostic(no_operand_${cpu} ${cpu} " jmpio" 1110 "wrong number of operands" 3 "")
    check_diagnostic(excess_operands_${cpu} ${cpu} " jmpio @0,@1" 1110 "wrong number of operands" 3 "")
    check_diagnostic(undefined_${cpu} ${cpu} " jmpio @missing" 1010 "symbol undefined" 3 9)
    check_bytes(indirect_edges_${cpu} ${cpu} " jmpio @0\n jmpio @15\n jmp @0\n jmp @15" "d002df02d000df00")
endforeach()
check_bytes(original MSM5054 " jmpio @0\n jmp @15\n mov #15,0\n beq 32" "d002df00f01c5c06")
foreach(cpu MSM5054 MSM5055 MSM5056 MSM6051 MSM6052)
    if(cpu STREQUAL MSM5054)
        set(limit 1023)
    elseif(cpu STREQUAL MSM6051)
        set(limit 4095)
    else()
        set(limit 2047)
    endif()
    math(EXPR overflow "${limit} + 1")
    foreach(op BEQ BZE BNE BNZ BCS BLT BCC BGE)
        check_diagnostic(branch_overflow_${op}_${cpu} ${cpu} " ${op} ${overflow}" 1320 "${overflow} > ${limit}" 3 6)
        check_diagnostic(branch_undefined_${op}_${cpu} ${cpu} " ${op} missing" 1010 "symbol undefined" 3 6)
    endforeach()
endforeach()
foreach(cpu MSM5054 MSM5055 MSM5056 MSM6051)
    check_bytes(forward_branch_${cpu} ${cpu} " beq target\n nop\ntarget: nop" "410600000000")
    check_bytes(forward_maximum_${cpu} ${cpu} " beq target\ntarget equ 32" "5f06")
    check_diagnostic(forward_too_far_${cpu} ${cpu} " beq target\ntarget equ 33" 1370 "jump distance too big" 3 "")
endforeach()
check_bytes(forward_branch_MSM6052 MSM6052 " beq target\n nop\ntarget: nop" "413a00000000")
check_bytes(forward_maximum_MSM6052 MSM6052 " beq target\ntarget equ 32" "5f3a")
check_diagnostic(forward_too_far_MSM6052 MSM6052 " beq target\ntarget equ 33" 1370 "jump distance too big" 3 "")
