    check_diagnostic(memory_second_${op} MSM6052 " ${op} +,bad" 1350 "operand must be Z, N, L" 3 9)
    check_diagnostic(memory_third_${op} MSM6052 " ${op} +,z,bad" 1350 "operand must be L" 3 11)
endforeach()
