file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

# These instructions accept Z/Z+ exclusively, but retain core availability checks.
foreach(instruction IN ITEMS lpm elpm)
    if(instruction STREQUAL "lpm")
        set(column 9)
    else()
        set(column 10)
    endif()
    foreach(pointer IN ITEMS X X+ -X Y Y+ -Y -Z)
        string(REPLACE "+" "post" name "${pointer}")
        string(REPLACE "-" "pre" name "${name}")
        check_diagnostic("${instruction}-${name}" ATMEGA16 " ${instruction} r0,${pointer}" 1350
            "this instruction accepts only Z or Z+ as its program pointer" 3 "${column}")
    endforeach()
    foreach(pointer IN ITEMS W Z++)
        string(REPLACE "+" "post" name "${pointer}")
        check_diagnostic("${instruction}-syntax-${name}" ATMEGA16 " ${instruction} r0,${pointer}" 1350
            "unrecognized program-pointer syntax; expected Z or Z+" 3 "${column}")
    endforeach()
    foreach(reg IN ITEMS 30 31)
        if(instruction STREQUAL "lpm")
            set(reg_column 6)
        else()
            set(reg_column 7)
        endif()
        check_diagnostic("${instruction}-overlap-${reg}" ATMEGA16 " ${instruction} r${reg},Z+" 140
            "destination register R${reg} overlaps Z (R31:R30), which is incremented by Z+" 3 "${reg_column}" 0)
    endforeach()
endforeach()
check_diagnostic(alias-overlap ATMEGA16 "dst reg r30\n lpm dst,Z+" 140
    "destination register R30 overlaps Z (R31:R30), which is incremented by Z+" 4 6 0)
check_diagnostic(lpm-classic AT90S8515 " lpm r0,Z" 1500 "instruction not supported" 3 "")
check_diagnostic(elpm-classic AT90S8515 " elpm" 1500 "instruction not supported" 3 "")
check_diagnostic(elpm-tiny ATTINY13 " elpm r0,Z" 1500 "instruction not supported" 3 "")
check_diagnostic(lpm-small AT90S1200 " lpm" 1500 "instruction not supported" 3 "")
check_diagnostic(bad-register ATMEGA16 " lpm r32,Z" 1445 "invalid register" 3 6)
check_diagnostic(minimum-cpu 320C203 " addc *AR0+" 1505
    "supported by 320C50 and above" 3 7)
check_diagnostic(minimum-cpu-minus 320C203 " addc *AR0-" 1505
    "supported by 320C50 and above" 3 7)

# Golden encodings from the preceding build, including code emitted with warnings.
check_bytes(avr-forms ATMEGA16
    " lpm\n lpm r0,Z\n lpm r29,Z+\n lpm r30,Z\n lpm r31,Z\n elpm\n elpm r0,Z\n elpm r29,Z+\n elpm r30,Z\n elpm r31,Z\n lpm r30,Z+\n elpm r31,Z+"
    "c8950490d591e491f491d8950690d791e691f691e591f791" -n -x)
string(REGEX MATCHALL "warning #140:" warnings "${assembly_diagnostic}")
list(LENGTH warnings warning_count)
if(NOT warning_count EQUAL 2)
    message(FATAL_ERROR "expected two overlap warnings: ${assembly_diagnostic}")
endif()
check_bytes(minimum-cpu-valid 320C50 " addc *AR0+\n addc *AR0-" "e060d060")
check_bytes(lpm-tiny ATTINY13 " lpm r0,Z\n lpm r1,Z+" "04901590")
check_bytes(lpm-classic-valid AT90S8515 " lpm" "c895")
check_bytes(avr-alias ATMEGA16 "dst reg r29\n lpm dst,z+\n elpm dst,z" "d591d691")

set(ENV{LC_MESSAGES} de)
foreach(item IN ITEMS "lpm-X|nur Z oder Z+" "elpm-syntax-W|erwartet wird Z oder Z+" "lpm-overlap-30|R30" "minimum-cpu|320C50")
    string(REPLACE "|" ";" fields "${item}")
    list(GET fields 0 name)
    list(GET fields 1 detail)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    string(FIND "${output}${error}" "${detail}" detail_pos)
    if((NOT "${result}" STREQUAL "2" AND NOT "${result}" STREQUAL "0") OR detail_pos EQUAL -1)
        message(FATAL_ERROR "German ${name}: ${result}\n${output}${error}")
    endif()
endforeach()
set(ENV{LC_MESSAGES} en)
