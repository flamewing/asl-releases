function(check_field name op count field value id detail)
    set(body " ${op} ")
    foreach(index RANGE 1 ${count})
        if(index GREATER 1)
            string(APPEND body ",")
        endif()
        if(index EQUAL field)
            string(LENGTH "${body}" column)
            math(EXPR column "${column} + 1")
            string(APPEND body "${value}")
        elseif(index EQUAL 2 AND op STREQUAL lda)
            string(APPEND body LC0)
        elseif(index EQUAL 2 AND op STREQUAL gma)
            string(APPEND body GFS)
        endif()
    endforeach()
    check_diagnostic(${name} TC9331 "${body}" ${id} "${detail}" 3 ${column})
endfunction()
