file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu F3850 MK3850 MK3870 MK3870/10 MK3870/12 MK3870/20 MK3870/22 MK3870/30 MK3870/32 MK3870/40 MK3870/42 MK3872 MK3873 MK3873/10 MK3873/12 MK3873/20 MK3873/22 MK3874 MK3875 MK3875/22 MK3875/42 MK3876 MK38P70/02 MK38C70/10 MK38C70/20 MK97400 MK97410 MK97500 MK97501 MK97503)
    string(REPLACE "/" "_" key "${cpu}")
    foreach(op HET HAL)
        check_diagnostic(cmos_${key}_${op} ${cpu} " ${op}" 1500 "supported only by MK38CP70/02 or MK38C70" 3 2)
    endforeach()
endforeach()
foreach(cpu MK38CP70/02 MK38C70)
    string(REPLACE "/" "_" key "${cpu}")
    check_bytes(cmos_${key} ${cpu} " het\n hal" "2e2f")
endforeach()
check_diagnostic(lr_pair F3850 " lr dc,p" 1350 "allowed addressing forms: (A,R), (R,A), (DC,Q), (DC,H), (Q,DC), (H,DC), (K,P), (P,K), (P0,Q), (J,W), (W,J); R=0..15/J/HU/HL/S/I/D/KU/KL/QU/QL/IS" 3 5)
foreach(op SL SR)
    foreach(count 0 2 3 5 6 7)
        check_diagnostic(shift_${op}_${count} F3850 " ${op} ${count}" 1380 "shift count ${count} must be 1 or 4" 3 5)
    endforeach()
endforeach()
foreach(op BC BM BNC BNO BNZ BP BR BR7 BZ BF BT)
    if(op STREQUAL "BF" OR op STREQUAL "BT")
        set(prefix "0,")
    else()
        set(prefix "")
    endif()
    string(LENGTH "${op}" length)
    string(LENGTH "${prefix}" prefix_length)
    math(EXPR column "${length}+${prefix_length}+3")
    check_diagnostic(upper_${op} F3850 " ${op} ${prefix}129" 1370 "branch displacement 128 outside [-128,127] (PC base 0x1)" 3 "${column}")
    check_diagnostic(lower_${op} F3850 " org 128\n ${op} ${prefix}0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 "${column}")
endforeach()
check_diagnostic(undefined F3850 " br missing" 1010 "symbol undefined" 3 5)
check_diagnostic(no_wrap F3850 " org 65534\n br 0" 1370 "branch displacement -65535 outside [-128,127]" 4 5)
check_diagnostic(shift_type_range F3850 " sl 8" 1320 "8 > 7" 3 5)
check_bytes(original F3850 " lr a,ku\n lr kl,a\n lr dc,q\n lr q,dc\n lr j,w\n sl 1\n sl 4\n sr\n br 136" "00050f0e1e131512907f")
check_bytes(upper_edge F3850 " br 128" "907f")
check_bytes(lower_edge F3850 " org 127\n br 0" "9080")
check_bytes(forward F3850 " br target\n nop\ntarget: nop" "90022b2b")
check_bytes(shift_forward F3850 " sl count\ncount equ 4" "15")
check_diagnostic(shift_undefined F3850 " sl missing" 1010 "symbol undefined" 3 5)
check_diagnostic(branch12 MK3870 " org 4094\n br 0" 1370 "branch displacement -4095 outside [-128,127]" 4 5)
