file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()





foreach(cpu 8096 80196 80196N 80296)
    foreach(pair JC:db JE:df JGE:d6 JGT:d2 JH:d9 JLE:da JLT:de JNC:d3 JNE:d7 JNH:d1 JNST:d0 JNV:d5 JNVT:d4 JST:d8 JV:dd JVT:dc)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 op)
        list(GET parts 1 code)
        check_bytes(forward_${op}_${cpu} ${cpu} " ${op} target+1000\ntarget equ -998" "${code}00")
        check_bytes(forward_lower_${op}_${cpu} ${cpu} " org 2000\n ${op} target-1000\ntarget equ 3002" "${code}00")
    endforeach()
    check_bytes(forward_djnz_${cpu} ${cpu} " djnz 20h,target+1000\ntarget equ -997" "e02000")
    check_bytes(forward_lower_djnz_${cpu} ${cpu} " org 2000\n djnz 20h,target-1000\ntarget equ 3003" "e02000")
    foreach(pair jbc:31 jbs:39)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 op)
        list(GET parts 1 code)
        check_bytes(forward_${op}_${cpu} ${cpu} " ${op} 20h,1,target+1000\ntarget equ -997" "${code}2000")
        check_bytes(forward_lower_${op}_${cpu} ${cpu} " org 2000\n ${op} 20h,1,target-1000\ntarget equ 3003" "${code}2000")
    endforeach()
    check_diagnostic(final_conditional_range_${cpu} ${cpu} " je target\ntarget equ 1000" 1370 "jump distance too big" 3 5)
    check_diagnostic(final_djnz_range_${cpu} ${cpu} " djnz 20h,target\ntarget equ 1000" 1370 "jump distance too big" 3 11)
    check_diagnostic(final_bit_range_${cpu} ${cpu} " jbc 20h,1,target\ntarget equ 1000" 1370 "jump distance too big" 3 12)
    check_bytes(original_branches_${cpu} ${cpu} " je 2\n djnz 20h,5\n jbc 20h,1,8\n sjmp 10\n scall 12" "df00e0200031200020002800")
    if(NOT cpu STREQUAL "8096")
        check_bytes(forward_djnzw_${cpu} ${cpu} " djnzw 20h,target+1000\ntarget equ -997" "e12000")
    endif()
endforeach()

foreach(cpu 8096 80196 80196N 80296)
    check_bytes(forward_forced_index_${cpu} ${cpu} " ld 20h,<target+1000[22h]\ntarget equ -1000" "a3220020")
    check_bytes(forward_lower_forced_index_${cpu} ${cpu} " org 2000\n ld 20h,<target-1000[22h]\ntarget equ 1000" "a3220020")
    check_bytes(forward_forced_short_absolute_${cpu} ${cpu} " ld 20h,<target\ntarget equ 0ff80h" "a3008020")
    check_bytes(indexed_endpoints_${cpu} ${cpu} " ld 20h,<-128[22h]\n ld 20h,<127[22h]" "a3228020a3227f20")
    check_bytes(short_absolute_endpoints_${cpu} ${cpu} " ld 20h,<0ff80h\n ld 20h,<0fffeh" "a3008020a300fe20")
    check_diagnostic(final_indexed_upper_${cpu} ${cpu} " ld 20h,<target[22h]\ntarget equ 128" 1320 "range overflow" 3 9)
    check_diagnostic(final_indexed_lower_${cpu} ${cpu} " ld 20h,<target[22h]\ntarget equ -129" 1315 "range underflow" 3 9)
    check_diagnostic(final_absolute_short_${cpu} ${cpu} " ld 20h,<target\ntarget equ 1000" 1315 "range underflow" 3 9)
endforeach()
