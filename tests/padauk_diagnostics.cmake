file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(cpu PMC150 PFS154 PMS133 DF69)
    foreach(op ADDC SUBC IDXM)
        check_diagnostic(pair_${op}_${cpu} ${cpu} " ${op} [2],[4]" 1350 "allowed addressing forms: A, mem; mem, A" 3 7)
        check_diagnostic(primary_pair_${op}_${cpu} ${cpu} " ${op} missing,missing" 1350 "allowed addressing forms: A, mem; mem, A" 3 7)
        check_bytes(reject_pair_${op}_${cpu} ${cpu} " expect 1350\n ${op} [2],[4]\n endexpect\n nop" "0000")
    endforeach()
endforeach()
set(body " addc a,[1]\n addc [1],a\n subc a,[1]\n subc [1],a\n idxm a,[2]\n idxm [2],a\n nop")
check_bytes(original13 PMC150 "${body}" "81068104c106c104e300e2000000")
check_bytes(original14 PFS154 "${body}" "010d0109810d8109830382030000")
check_bytes(original15 PMS133 "${body}" "011a0112011b0113030702070000")
check_bytes(original16 DF69 "${body}" "014a0148014e014c030802080000")

foreach(cpu PMC150 PFS154 PMS133 DF69)
    if(cpu STREQUAL "PMC150")
        set(ram_limit 63)
        set(io_limit 31)
    elseif(cpu STREQUAL "PFS154")
        set(ram_limit 127)
        set(io_limit 63)
    elseif(cpu STREQUAL "PMS133")
        set(ram_limit 255)
        set(io_limit 127)
    else()
        set(ram_limit 207)
        set(io_limit 63)
    endif()
    if(ram_limit LESS 255)
        math(EXPR ram_over "${ram_limit} + 1")
        check_diagnostic(ram_${cpu} ${cpu} "ram equ 0,data\n mov a,ram+${ram_over}" 1320 "DATA argument ${ram_over} outside [0,${ram_limit}]" 4 8)
    endif()
    math(EXPR io_over "${io_limit} + 1")
    check_diagnostic(io_${cpu} ${cpu} "port sfr 0\n mov a,port+${io_over}" 1320 "IO argument ${io_over} outside [0,${io_limit}]" 4 8)
    check_diagnostic(destination_${cpu} ${cpu} " mov #1,a" 1350 "allowed addressing forms: A, [expr], disp[expr], expr[index], expr (DATA), IO(expr), expr (IO)" 3 6)
    check_diagnostic(source_${cpu} ${cpu} " mov a,a" 1350 "allowed addressing forms: [expr], disp[expr], expr[index], expr (DATA), IO(expr), expr (IO), #expr, expr (absolute)" 3 8)
    check_diagnostic(acc_${cpu} ${cpu} " mov [1],#1" 1350 "allowed addressing forms: A" 3 10)
    check_diagnostic(memory_${cpu} ${cpu} " inc #1" 1350 "allowed addressing forms: [expr], disp[expr], expr[index], expr (DATA)" 3 6)
    check_diagnostic(immediate_${cpu} ${cpu} " ret [1]" 1350 "allowed addressing forms: #expr, expr (absolute)" 3 6)
    check_diagnostic(no_bits_${cpu} ${cpu} " set0" 1110 "expected between 1 and 2 arguments but got 0" 3 "")
    check_diagnostic(too_many_bits_${cpu} ${cpu} " set0 [1],0,1" 1110 "expected between 1 and 2 arguments but got 3" 3 "")
    check_diagnostic(struct_bit_${cpu} ${cpu} "mystruct struct\nmember res 1\nflag bit member\n endstruct" 1110 "allowed addressing forms: element.bit; element, bit" 5 10)
endforeach()
foreach(op TOG WAIT0 WAIT1 SWAPC)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(io_bit_${op} DF69 " ${op} [1],0" 1350 "allowed addressing forms: IO(expr).bit, IO(expr), bit; expr (IO bit)" 3 ${column})
endforeach()

check_diagnostic(restricted_swap PMC150 " swap [1]" 1350 "allowed addressing forms: A" 3 7)
check_diagnostic(word_memory DF69 " idxm a,#1" 1350 "allowed addressing forms: [expr], disp[expr], expr[index], expr (DATA)" 3 9)
