cmake_minimum_required(VERSION 3.19)
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(name IN ITEMS PLISTCMD BINDCMD P2BINCMD P2HEXCMD ALINKCMD DASCMD)
    set(ENV{${name}} "")
endforeach()
foreach(language IN ITEMS en de)
    set(ENV{LC_MESSAGES} "${language}")
    foreach(program IN ITEMS PLIST PBIND P2BIN P2HEX ALINK DASL)
        execute_process(COMMAND ${TEST_EMULATOR} "${${program}_PROGRAM}" -help
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
        if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "-help" OR NOT output MATCHES "-version")
            message(FATAL_ERROR "${program} ${language} help: ${result}\n${output}${error}")
        endif()
        if(program STREQUAL "DASL")
            foreach(option IN ITEMS -cpu -binfile -hexfile -entryaddress -symbol -screenheight)
                string(FIND "${output}" "${option}" pos)
                if(pos EQUAL -1)
                    message(FATAL_ERROR "DASL ${language} help omits ${option}")
                endif()
            endforeach()
            if(language STREQUAL "en" AND NOT output MATCHES "options:")
                message(FATAL_ERROR "DASL English help is not the English catalog")
            endif()
        endif()
        if(program STREQUAL "P2HEX" AND NOT output MATCHES "-cformat")
            message(FATAL_ERROR "P2HEX ${language} help omits C-format selection")
        endif()
        execute_process(COMMAND ${TEST_EMULATOR} "${${program}_PROGRAM}" -version
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 15)
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "${program} version request exits ${result}")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND ${TEST_EMULATOR} "${DASL_PROGRAM}" -z -help
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 15)
if(NOT "${result}" STREQUAL "4")
    message(FATAL_ERROR "DASL silently accepts an unknown option: ${result}")
endif()
if(DEFINED RESCOMP_PROGRAM AND NOT "${RESCOMP_PROGRAM}" STREQUAL "")
    # rescomp is a native host tool even in cross-builds.
    execute_process(COMMAND "${RESCOMP_PROGRAM}" -help
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "-m OUTPUT.msg"
            OR NOT output MATCHES "-h OUTPUT.rsc" OR NOT output MATCHES "-i OUTPUT.msh")
        message(FATAL_ERROR "rescomp help: ${result}\n${output}${error}")
    endif()
endif()
