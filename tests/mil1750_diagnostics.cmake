file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(register 1750 " ar r16,r0" 1445 "operand must be R0..R15" 3 5)
check_diagnostic(base 1750 " ab b11,0" 1445 "operand must be R12..R15, B12..B15" 3 5)
check_diagnostic(index_memory 1750 " a r1,0,r0" 1350 "operand must be R1..R15" 3 9)
check_diagnostic(index_base 1750 " abx b12,r0" 1350 "operand must be R1..R15" 3 10)
check_diagnostic(index_io 1750 " xio r1,smk,r0" 1350 "operand must be R1..R15" 3 13)
foreach(op BEZ BNZ BGT BLE BGE BLT BR)
    string(LENGTH "${op}" op_length)
    math(EXPR column "${op_length} + 3")
    check_diagnostic(upper_${op} 1750 " ${op} 128" 1370 "branch displacement 128 outside [-128,127] (PC base 0x0)" 3 ${column})
    check_diagnostic(lower_${op} 1750 " org 129\n ${op} 0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 ${column})
    check_diagnostic(undefined_${op} 1750 " ${op} missing" 1010 "symbol undefined" 3 ${column})
endforeach()
check_bytes(original 1750 " ar r0,r15\n ab b12,255\n ab r15,0\n a r1,65535,r15\n abx b12,r1\n xio r0,smk,r15\n br 133" "0fa1ff1000131fa0ffff41400f4800207d74")
check_bytes(upper_edge 1750 " br 127" "7f74")
check_bytes(lower_edge 1750 " org 128\n br 0" "8074")
check_bytes(zero 1750 " br 0" "0074")
check_bytes(forward 1750 " br target\n nop\ntarget: nop" "027400ff00ff")
check_bytes(register_syntax 1750 " ar r,r15\n ar r000,r015" "0fa10fa1")
check_diagnostic(no_wrap_upper 1750 " br 65535" 1370 "branch displacement 65535 outside [-128,127] (PC base 0x0)" 3 5)
check_diagnostic(no_wrap_lower 1750 " org 65535\n br 0" 1370 "branch displacement -65535 outside [-128,127] (PC base 0xFFFF)" 4 5)
check_diagnostic(register_second 1750 " ar r0,r16" 1445 "operand must be R0..R15" 3 8)
check_diagnostic(base_r 1750 " ab r11,0" 1445 "operand must be R12..R15, B12..B15" 3 5)
