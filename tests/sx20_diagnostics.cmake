file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(cpu SX20 SX28)
    check_bytes(signed_${cpu} ${cpu} " retw -1\n mode -1\n retw -128\n mode -8" "ff085f0080085800")
    check_bytes(unsigned_equivalent_${cpu} ${cpu} " retw 255\n mode 15\n retw 128\n mode 8" "ff085f0080085800")
    check_diagnostic(retw_under_${cpu} ${cpu} " retw -129" 1315 "-129 < -128" 3 7)
    check_diagnostic(mode_under_${cpu} ${cpu} " mode -9" 1315 "-9 < -8" 3 7)
endforeach()

foreach(prefix ++ --)
    check_diagnostic(movsz_range_${prefix} SX20 " movsz w,${prefix}256" 1320 "256 > 255" 3 12)
    check_diagnostic(movsz_undefined_${prefix} SX20 " movsz w,${prefix}missing" 1010 "symbol undefined" 3 12)
    check_bytes(movsz_reject_${prefix} SX20 " expect 1320\n movsz w,${prefix}256\n endexpect\n nop" "0000")
endforeach()
check_bytes(movsz_original SX20 " movsz w,--$b\n movsz w,++$e" "cb02ce03")

foreach(cpu SX20 SX28)
    check_diagnostic(mov_m_${cpu} ${cpu} " mov m,8" 1350 "allowed addressing forms: #expression (-8..15)" 3 8)
    check_diagnostic(mov_pairs_${cpu} ${cpu} " mov 8,9" 1350 "W,#expr; W,M; W,reg" 3 6)
    check_diagnostic(movsz_form_${cpu} ${cpu} " movsz w,8" 1350 "allowed addressing forms: --reg / ++reg" 3 10)
    check_diagnostic(movsz_dest_${cpu} ${cpu} " movsz 8,++8" 1350 "operand must be W" 3 8)
    check_diagnostic(add_immediate_${cpu} ${cpu} " add w,#1" 1350 "allowed addressing forms: reg" 3 8)
    check_diagnostic(add_pairs_${cpu} ${cpu} " add 8,9" 1350 "allowed addressing forms: W,reg; reg,W" 3 6)
    check_diagnostic(and_pairs_${cpu} ${cpu} " and 8,9" 1350 "allowed addressing forms: W,reg; reg,W; W,#expr" 3 6)
    check_diagnostic(sub_dest_${cpu} ${cpu} " sub 8,9" 1350 "operand must be W" 3 8)
    check_diagnostic(register_page_${cpu} ${cpu} " assume fsr:$20\n inc $30" 110 "address 0x30 requires FSR selector 0x30; ASSUME FSR=0x20 selects 0x20 (mask 0xF0)" 4 6 0)
    check_diagnostic(bit_page_${cpu} ${cpu} " assume fsr:$20\n setb $30.0" 110 "address 0x30 requires FSR selector 0x30; ASSUME FSR=0x20 selects 0x20 (mask 0xF0)" 4 7 0)
    foreach(op JMP CALL)
        string(LENGTH "${op}" length)
        math(EXPR column "${length} + 3")
        check_diagnostic(target_page_${op}_${cpu} ${cpu} " assume status:$20\n ${op} $400" 110 "address 0x400 requires STATUS selector 0x40; ASSUME STATUS=0x20 selects 0x20 (mask 0xE0)" 4 ${column} 0)
    endforeach()
    check_diagnostic(call_bit_${cpu} ${cpu} " call $100" 1905 "CALL target 0x100 has bit 8 set; bit 8 must be clear" 3 7)
    check_bytes(warning_bytes_${cpu} ${cpu} " assume fsr:$20,status:$20\n expect 110\n inc $30\n endexpect\n expect 110\n jmp $400\n endexpect" "b002000a")
endforeach()
check_bytes(operands_original SX20 " mov w,#1\n mov $e,w\n mov w,++$e\n movsz w,--$b\n movsz w,++$e\n and w,#$ff\n add $a,w\n sub $a,w\n jmp w\n jmp pc+w\n call $ff\n assume fsr:$30,status:$40\n inc $30\n setb $31.7\n jmp $400\n call $4ff" "010c2e008e02cb02ce03ff0eea01aa002200e201ff09b002f105000aff09")

foreach(cpu SX20 SX28)
    check_bytes(quoted_bit_${cpu} ${cpu} " clrb '.'.0\n sb '.'.0\n setb '.'.0\n snb '.'.0" "0e040e070e050e06")
    check_bytes(numeric_bit_${cpu} ${cpu} " clrb 46.0\n sb 46.0\n setb 46.0\n snb 46.0" "0e040e070e050e06")
    check_bytes(quoted_bit_symbol_${cpu} ${cpu} "symbol bit '.'.0\n setb symbol" "0e05")
endforeach()
