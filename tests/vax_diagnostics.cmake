file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(cpu MicroVAX-I VAX-11/780 VAX-8800)
    string(REPLACE "/" "_" tag "${cpu}")
    foreach(reg missing 1.5 "#1")
        string(MAKE_C_IDENTIFIER "${reg}" reg_tag)
        check_diagnostic(primary_${tag}_${reg_tag} ${cpu} " movl 1(${reg}),r0" 1445 "invalid register" 3 9)
    endforeach()
    check_diagnostic(nonreg_alias_${tag} ${cpu} "value equ 1\n movl 1(value),r0" 1147 "expected register" 4 9)
    check_bytes(reject_alias_${tag} ${cpu} "value equ 1\n expect 1147\n movl 1(value),r0\n endexpect\n byte 18" "12")
    check_bytes(register_bases_${tag} ${cpu} " movl 1(r1),r0\n movl (r2),r0\n movl (sp),r0\n movl 1(alias),r0\nalias equ r3" "d0a10150d06250d06e50d0a30150")
endforeach()

foreach(cpu MicroVAX-I VAX-11/780 VAX-8800)
    string(REPLACE "/" "_" tag "${cpu}")
    foreach(reg pc r15)
        check_diagnostic(pc_index_${tag}_${reg} ${cpu} " movl (r0)[${reg}],r1" 1439 "PC/R15 cannot be an index register" 3 12)
        check_bytes(reject_pc_index_${tag}_${reg} ${cpu} " expect 1439\n movl (r0)[${reg}],r1\n endexpect\n byte 18" "12")
    endforeach()
    check_diagnostic(pc_alias_index_${tag} ${cpu} "alias equ pc\n movl (r0)[alias],r1" 1439 "R0..R14" 4 12)
    foreach(reg RANGE 0 14)
        math(EXPR index "64 + ${reg}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${index}" 2 -1 index)
        check_bytes(valid_index_${tag}_${reg} ${cpu} " movl (r0)[r${reg}],r1" "d0${index}6051")
    endforeach()
    check_bytes(valid_named_index_${tag} ${cpu} " movl (r0)[ap],r1\n movl (r0)[fp],r1\n movl (r0)[sp],r1" "d04c6051d04d6051d04e6051")
endforeach()

foreach(cpu MicroVAX-I VAX-11/780 VAX-8800)
    string(REPLACE "/" "_" tag "${cpu}")
    check_bytes(forward_index_${tag} ${cpu} " movl (r0)[idx],r1\nidx equ r2" "d0426051")
    check_bytes(forward_named_index_${tag} ${cpu} " movl (r0)[idx],r1\nidx equ sp" "d04e6051")
    check_diagnostic(forward_pc_index_${tag} ${cpu} " movl (r0)[idx],r1\nidx equ pc" 1439 "PC/R15 cannot be an index register" 3 12)
    check_diagnostic(missing_index_${tag} ${cpu} " movl (r0)[missing],r1" 1445 "invalid register" 3 12)
    check_diagnostic(nonreg_index_${tag} ${cpu} "idx equ 1\n movl (r0)[idx],r1" 1147 "expected register" 4 12)
    check_bytes(reject_nonreg_index_${tag} ${cpu} "idx equ 1\n expect 1147\n movl (r0)[idx],r1\n endexpect\n byte 18" "12")
endforeach()

foreach(cpu MicroVAX-I VAX-11/780 VAX-8800)
    string(REPLACE "/" "_" tag "${cpu}")
    check_diagnostic(mode_mask_${tag} ${cpu} " movl r0,#1" 1350 "allowed addressing forms: Rn; (Rn)" 3 10)
    check_diagnostic(register_index_${tag} ${cpu} " movl r0[r1],r2" 1350 "(Rn)[Rx]" 3 7)
    check_diagnostic(immediate_index_${tag} ${cpu} " movl #1[r1],r2" 1350 "(Rn)[Rx]" 3 7)
    check_diagnostic(post_length_${tag} ${cpu} " movl b^(r0)+,r1" 1350 "length prefix B^ is not allowed with (Rn)+" 3 7)
    check_diagnostic(pre_deferred_${tag} ${cpu} " movl @-(r0),r1" 1350 "-(Rn), @(Rn)+ or @displacement(Rn)" 3 7)
    check_diagnostic(pre_length_${tag} ${cpu} " movl b^-(r0),r1" 1350 "length prefix B^ is not allowed with -(Rn)" 3 7)
    check_diagnostic(register_length_${tag} ${cpu} " movl b^(r0),r1" 1350 "length prefix B^ is not allowed with (Rn)" 3 7)
    check_diagnostic(post_index_${tag} ${cpu} " movl (r0)+[r0],r1" 140 "index register R0 is modified by base addressing (Rn)+" 3 7 0)
    check_diagnostic(pre_index_${tag} ${cpu} " movl -(r0)[r0],r1" 140 "index register R0 is modified by base addressing -(Rn)" 3 7 0)
    check_diagnostic(byte_branch_${tag} ${cpu} " brb 130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 6)
    check_diagnostic(word_branch_${tag} ${cpu} " brw 32771" 1370 "branch displacement 32768 outside [-32768,32767] (PC base 0x3)" 3 6)
    check_diagnostic(two_three_count_${tag} ${cpu} " addl r0" 1110 "expected 2 or 3 arguments but got 1" 3 "")
    check_diagnostic(three_five_count_${tag} ${cpu} " movc r0,r1,r2,r3" 1110 "expected 3 or 5 arguments but got 4" 3 "")
    if(NOT cpu STREQUAL "MicroVAX-I")
        check_diagnostic(four_six_count_${tag} ${cpu} " addp r0" 1110 "expected 4 or 6 arguments but got 1" 3 "")
        check_diagnostic(three_four_count_${tag} ${cpu} " cmpp r0" 1110 "expected 3 or 4 arguments but got 1" 3 "")
    endif()
    check_bytes(branch_and_warnings_${tag} ${cpu} " brb 129\n brw 32772\n movl (r0)+[r0],r1\n movl -(r0)[r0],r1" "117f31ff7fd0408051d0407051")
endforeach()
