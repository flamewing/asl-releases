file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(range_primary HD614023 " ld 160,a" 1320 "LD argument 160 outside [0,159]" 3 5)
check_diagnostic(undefined_primary HD614023 " ld missing,a" 1010 "symbol undefined" 3 5)
check_diagnostic(later_instruction HD614023 " ld a,b\n ld missing,a" 1010 "symbol undefined" 4 5)
check_diagnostic(imm_primary HD614023 " ld #missing,b" 1010 "symbol undefined" 3 6)
check_bytes(original HD614023 " ld #15,a\n ld a,b\n ld 159,a\n ld a,m+\n bset ca\n bclr 3,m" "3f02c80090019f005000ef008b00")
check_bytes(forward HD614023 " ld value,a\nvalue equ 159" "90019f00")
check_diagnostic(ld_dest HD614023 " ld a,spx" 1350 "allowed addressing forms: A, B, X, Y, W, M, M+, M-, expr" 3 7)
check_diagnostic(ld_src HD614023 " ld x,a" 1350 "allowed addressing forms: B, Y, M, SPX, SPY, #expr, expr, MR0..MR15" 3 5)
check_diagnostic(ld_w HD614023 " ld a,w" 1350 "allowed addressing forms: #expr" 3 5)
check_diagnostic(ld_m HD614023 " ld b,m" 1350 "allowed addressing forms: A" 3 5)
check_diagnostic(xch HD614023 " xch b,x" 1350 "allowed addressing forms: SPX" 3 6)
foreach(op BSET BCLR BTST)
    check_diagnostic(bit_${op} HD614023 " ${op} a" 1350 "operand must be CA" 3 7)
endforeach()
foreach(op LAMD LMAD XMAD AMD AMCD SMCD ANMD ORMD EORMD ANEMD ALEMD)
    string(LENGTH "${op}" length)
    math(EXPR column "${length}+3")
    check_diagnostic(dir_${op} HD614023 " ${op} 160" 1320 "${op} argument 160 outside [0,159]" 3 "${column}")
endforeach()
check_diagnostic(inc HD614023 " inc a" 1350 "allowed addressing forms: B, Y" 3 6)
check_diagnostic(cp HD614023 " cp le,x,a" 1350 "allowed addressing forms: M, #expr, expr" 3 8)
check_diagnostic(imm_width HD614023 " ld #4,w" 1320 "4 > 3" 3 6)
check_bytes(cpu043 HD614043 " ld 255,a" "9001ff00")
check_bytes(cpu081 HD614081 " ld 511,a" "9001ff01")
check_bytes(w_size HD614023 " ld #3,w" "f300")
