file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu COP410 COP420 COP440 COP444)
    check_diagnostic(zero_${cpu} ${cpu} " aisc 0" 1315 "AISC argument 0 must be in [-8,15]; zero is not allowed" 3 7)
    foreach(pc 128 255)
        check_diagnostic(placement_${cpu}_${pc} ${cpu} " org ${pc}\n jsrp 0x80" 1900 "forbidden interval [0x80,0xFF]" 4 2)
    endforeach()
    foreach(target 127 191 192)
        check_diagnostic(target_${cpu}_${target} ${cpu} " jsrp ${target}" 1905 "JSRP argument ${target} outside [128,190]" 3 7)
    endforeach()
endforeach()
check_diagnostic(xad_first COP410 " xad 2,15" 1350 "COP410 XAD requires operands 3,15 (got 2,15)" 3 6)
check_diagnostic(xad_second COP410 " xad 3,14" 1350 "COP410 XAD requires operands 3,15 (got 3,14)" 3 8)
check_diagnostic(xad_both COP410 " xad 0,0" 1350 "COP410 XAD requires operands 3,15 (got 0,0)" 3 6)
check_diagnostic(undefined COP410 " aisc missing" 1010 "symbol undefined" 3 7)
check_diagnostic(jsrp_undefined COP410 " jsrp missing" 1010 "symbol undefined" 3 7)
check_diagnostic(target_before_placement COP410 " org 128\n jsrp 191" 1905 "JSRP argument 191 outside [128,190]" 4 7)
check_bytes(original COP410 " aisc -8\n aisc -1\n aisc 1\n aisc 15\n xad 3,15\n jsrp 0x80\n jsrp 0xbe" "585f515f23bf80be")
foreach(cpu COP420 COP440 COP444)
    check_bytes(extended_${cpu} ${cpu} " xad 0,0\n xad 3,15" "238023bf")
endforeach()
check_bytes(forward COP410 " aisc value\n xad regno,offset\nvalue equ 1\nregno equ 3\noffset equ 15" "5123bf")
check_bytes(placement_low COP410 " org 127\n jsrp 128" "80")
check_bytes(placement_high COP410 " org 256\n jsrp 190" "be")
set(ENV{LC_MESSAGES} de)
file(TO_NATIVE_PATH "${TEST_DIR}/zero_COP410.asm" source)
execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
string(FIND "${output}${error}" "AISC-Argument 0 muss in [-8,15] liegen; Null ist nicht erlaubt" detail_pos)
if(NOT "${result}" STREQUAL "2" OR detail_pos EQUAL -1)
    message(FATAL_ERROR "German nonzero: ${result}\n${output}${error}")
endif()
