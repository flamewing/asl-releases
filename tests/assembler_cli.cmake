cmake_minimum_required(VERSION 3.19)
file(MAKE_DIRECTORY "${TEST_DIR}")
set(ENV{ASCMD} "")

function(invoke expected)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${result}\n${output}${error}")
    endif()
    set(text "${output}${error}" PARENT_SCOPE)
endfunction()

foreach(language IN ITEMS en de)
    set(ENV{LC_MESSAGES} "${language}")
    invoke(0 -help)
    foreach(option IN ITEMS -compmode -packing -supmode -noicemask -warnranges -X
            -maxsympass -listing -listline-prefix -listradix -version)
        string(FIND "${text}" "${option}" pos)
        if(pos EQUAL -1)
            message(FATAL_ERROR "${language} help omits ${option}")
        endif()
    endforeach()
    if(NOT text MATCHES "\n  -listing [^\n]*\n")
        message(FATAL_ERROR "${language} listing help merges adjacent options")
    endif()
    string(FIND "${text}" "-help | -version | -cpu list" pos)
    if(pos EQUAL -1)
        message(FATAL_ERROR "${language} informational invocation missing")
    endif()
endforeach()
set(ENV{LC_MESSAGES} en)
invoke(1)
invoke(4 --help)
invoke(0 -version)
invoke(0 -cpu list)
string(FIND "${text}" "68000" pos)
if(pos EQUAL -1)
    message(FATAL_ERROR "CPU list omits documented example target")
endif()

file(WRITE "${TEST_DIR}/source with spaces.asm" " dc.b 1\n")
file(WRITE "${TEST_DIR}/options.key" "-cpu 68000 -q\n")
invoke(0 -cpu 68000 -q -o output.p "source with spaces.asm")
if(NOT EXISTS "${TEST_DIR}/output.p")
    message(FATAL_ERROR "Documented explicit output invocation produced no file")
endif()
invoke(0 @options.key -o key.p "source with spaces.asm")
set(ENV{ASCMD} "-cpu 68000 -q")
invoke(0 -o preset.p "source with spaces.asm")
set(ENV{ASCMD} "-cpu 68000 -q @nested.key")
invoke(4 -help)
set(ENV{ASCMD} "-z")
invoke(4 -help)
file(WRITE "${TEST_DIR}/invalid.key" "-z\n")
set(ENV{ASCMD} "@invalid.key")
invoke(4 -help)
