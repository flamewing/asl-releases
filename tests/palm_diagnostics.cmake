file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu IBM5100 IBM5110 IBM5120)
    check_diagnostic(byte_modifier_${cpu} ${cpu} " movb r1,(r2)+++++" 1350 "indirect operand has 5 full and 0 half modifiers; byte operations allow at most four full modifiers and no half modifiers" 3 10)
    check_diagnostic(byte_half_${cpu} ${cpu} " movb r1,(r2)~" 1350 "indirect operand has 0 full and 1 half modifiers" 3 10)
    check_diagnostic(word_modifier_${cpu} ${cpu} " move r1,(r2)+++" 1350 "indirect operand has 3 full and 0 half modifiers; word operations allow at most two modifiers in total" 3 10)
    check_diagnostic(word_half_${cpu} ${cpu} " move r1,(r2)--~" 1350 "indirect operand has 2 full and 1 half modifiers" 3 10)
    check_diagnostic(mask_${cpu} ${cpu} " add #1,r2" 1350 "allowed addressing forms: R0..R15, PC" 3 6)
    check_diagnostic(upper_${cpu} ${cpu} " bra 260" 1370 "branch displacement 258 outside [-256,256] (PC base 0x2); zero is reserved" 3 6)
    check_diagnostic(lower_${cpu} ${cpu} " org 256\n bra 0" 1370 "branch displacement -258 outside [-256,256] (PC base 0x102)" 4 6)
    check_diagnostic(zero_${cpu} ${cpu} " bra 2" 1371 "branch displacement 0 is not encodable (PC base 0x2)" 3 6)
    check_diagnostic(rcall_upper_${cpu} ${cpu} " rcall 262,r1" 1370 "branch displacement 258 outside [-256,256] (PC base 0x4)" 3 8)
    check_diagnostic(rcall_zero_${cpu} ${cpu} " rcall 4,r1" 1371 "branch displacement 0 is not encodable (PC base 0x4)" 3 8)
    check_diagnostic(direct_odd_${cpu} ${cpu} " move r1,3" 1351 "operand address 0x3 must be aligned to 2 bytes" 3 10)
    check_diagnostic(target_odd_${cpu} ${cpu} " bra 3" 1351 "operand address 0x3 must be aligned to 2 bytes" 3 6)
    check_diagnostic(instruction_odd_${cpu} ${cpu} " org 1\n nop" 180 "instruction address 0x1 must be aligned to 2 bytes" 4 2 0)
    check_diagnostic(undefined_${cpu} ${cpu} " bra missing" 1010 "symbol undefined" 3 6)
    check_bytes(upper_edge_${cpu} ${cpu} " bra 258" "a0ff")
    check_bytes(lower_edge_${cpu} ${cpu} " org 254\n bra 0" "f0ff")
    check_bytes(forward_${cpu} ${cpu} " bra target\n nop\ntarget: nop" "a00100040004")
    check_bytes(jmp_zero_${cpu} ${cpu} " jmp 2" "d0010000")
endforeach()
check_bytes(original IBM5100 " move r1,(r2)++\n movb r1,(r2)++++\n move r1,(r2)+\n bra 258\n rcall 264,r3\n jmp >600" "d1236123d121a0f90303a0fbd0010256")
check_diagnostic(io_mask IBM5100 " getb r1,#1" 1350 "allowed addressing forms: expr (I/O address 0..15)" 3 10)
check_diagnostic(move_mask IBM5100 " move #1,r2" 1350 "expr (even address 0..510)" 3 7)
check_diagnostic(movb_mask IBM5100 " movb r1,r2" 1350 "allowed addressing forms: (Rn) with optional update modifiers, #expr" 3 10)
check_diagnostic(putb_mask IBM5100 " putb 0,#1" 1350 "allowed addressing forms: R0..R15, PC, (Rn) with optional update modifiers" 3 9)
check_diagnostic(sub_mask IBM5100 " sub r1,0" 1350 "allowed addressing forms: R0..R15, PC, #expr" 3 9)
check_diagnostic(and_mask IBM5100 " and r1,0" 1350 "allowed addressing forms: R0..R15, PC, #expr" 3 9)
