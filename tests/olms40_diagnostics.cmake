file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu MSM5840 MSM5842 MSM58421 MSM58422 MSM5847)
    check_diagnostic(source_${cpu} ${cpu} " ld a,missing" 1010 "symbol undefined" 3 7)
    check_diagnostic(dest_${cpu} ${cpu} " ld a,0\n ld 16,a" 1320 "16 > 15" 4 5)
    check_diagnostic(overflow_${cpu} ${cpu} " ld a,16" 1320 "16 > 15" 3 7)
    check_diagnostic(bit_${cpu} ${cpu} " ld a,0\n bset 16,1" 1320 "16 > 15" 4 7)
    check_diagnostic(inc_${cpu} ${cpu} " ld a,0\n inc 16" 1320 "16 > 15" 4 6)
    check_bytes(forward_${cpu} ${cpu} " ld a,value\nvalue equ 15" "1f")
endforeach()
check_diagnostic(timer MSM5840 " ld t,256" 1320 "256 > 255" 3 7)
check_bytes(original MSM5840 " ld a,15\n ld t,-1\n inc m\n bset c\n thb 1\n lti -1\n ld x,a" "1f68ff5d40ad68ff81")

foreach(cpu MSM5842 MSM58421 MSM58422 MSM5847)
    check_diagnostic(timer_nonzero_${cpu} ${cpu} " ld t,1" 1320 "LD T argument 1 outside [0,0]" 3 7)
    check_diagnostic(timer_negative_${cpu} ${cpu} " ld t,-1" 1320 "LD T argument 255 outside [0,0]" 3 7)
    check_diagnostic(lti_nonzero_${cpu} ${cpu} " lti 1" 1320 "LTI argument 1 outside [0,0]" 3 6)
    check_diagnostic(lti_negative_${cpu} ${cpu} " lti -1" 1320 "LTI argument -1 outside [0,0]" 3 6)
    check_bytes(timer_zero_${cpu} ${cpu} " ld t,0\n lti\n lti 0" "686868")
endforeach()
foreach(cpu MSM58421 MSM58422)
    check_diagnostic(thb_nonzero_${cpu} ${cpu} " thb 1" 1320 "THB argument 1 outside [0,0]" 3 6)
    check_bytes(thb_zero_${cpu} ${cpu} " thb 0" "ac")
endforeach()
foreach(cpu MSM5840 MSM5842 MSM58421 MSM58422 MSM5847)
    foreach(op BSET BCLR BTST)
        check_diagnostic(carry_${op}_${cpu} ${cpu} " ${op} a" 1350 "operand must be C" 3 7)
    endforeach()
    check_diagnostic(inc_dest_${cpu} ${cpu} " inc pp" 1350 "allowed addressing forms:" 3 6)
    check_diagnostic(bit_dest_${cpu} ${cpu} " bset a,1" 1350 "allowed addressing forms: M, (DP), (PP)" 3 7)
    check_diagnostic(ld_dest_${cpu} ${cpu} " ld m,a" 1350 "allowed addressing forms:" 3 5)
endforeach()
check_diagnostic(forms5840 MSM5840 " ld a,pp" 1350 "allowed addressing forms: M, (DP), W, X, Y, Z, DPL, TL, TH, expr, #expr" 3 7)
check_diagnostic(forms5842 MSM5842 " ld a,x" 1350 "allowed addressing forms: M, (DP), W, DPL, expr, #expr" 3 7)
check_diagnostic(forms5847 MSM5847 " ld a,w" 1350 "allowed addressing forms: M, (DP), DPL, expr, #expr" 3 7)
check_diagnostic(dec_dph MSM5842 " dec dph" 1350 "allowed addressing forms: A, M, (DP), W, DPL" 3 6)
check_bytes(dec_dph5840 MSM5840 " dec dph" "5f")
check_bytes(small_original MSM58421 " ld a,-1\n ld t,0\n lti\n thb 0\n inc dpl\n bclr (pp),3\n btst m,2" "1f6868ac57b7a6")
check_bytes(thb_variable MSM5842 " thb 0\n thb 1" "acad")
