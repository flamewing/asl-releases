file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(cpu ST6200 ST6218)
    foreach(value 256 32767 32768 65535)
        check_diagnostic(address_${value}_${cpu} ${cpu} " ld a,${value}" 1320 "DATA argument ${value} outside [0,255]" 3 7)
        check_bytes(reject_address_${value}_${cpu} ${cpu} " expect 1320\n ld a,${value}\n endexpect\n nop" "04")
    endforeach()
    check_diagnostic(undefined_address_${cpu} ${cpu} " ld a,missing" 1010 "symbol undefined" 3 7)
    check_diagnostic(address_type_${cpu} ${cpu} " ld a,65536" 1320 "65536 > 65535" 3 7)
    check_bytes(original_${cpu} ${cpu} " ld a,0\n ld a,255\n ld 255,a\n ldi 255,-1\n ld a,x\n ld (x),a\n add a,(y)\n inc w\n assume rombase:1\nrom equ 64,code\n ld a,rom" "1f001fff9fff0dffff35874fd51f40")
endforeach()

foreach(cpu ST6200 ST6218)
    check_bytes(backward_original_${cpu} ${cpu} " org 256\n jrz pc-15\n jrnz pc-15\n jrc pc-15\n jrnc pc-15" "84808682")
    check_bytes(backward_wrap_${cpu} ${cpu} " jrz 65535\n jrnz 65535\n jrc 65535\n jrnc 65535" "f4e8e6da")
endforeach()

foreach(cpu ST6200 ST6218)
    foreach(pair "JRZ:0c" "JRNZ:08" "JRC:0e" "JRNC:0a")
        string(REPLACE ":" ";" fields "${pair}")
        list(GET fields 0 op)
        list(GET fields 1 opcode)
        check_bytes(forward_${op}_${cpu} ${cpu} " org 256\n ${op} target+1000\ntarget equ -742" "${opcode}")
        string(LENGTH "${op}" length)
        math(EXPR column "${length} + 3")
        check_diagnostic(resolved_far_${op}_${cpu} ${cpu} " ${op} target+1000\ntarget equ 0" 1370 "branch displacement 999 outside [-16,15] (PC base 0x1)" 3 ${column})
        check_diagnostic(undefined_${op}_${cpu} ${cpu} " ${op} target+1000" 1010 "symbol undefined" 3 ${column})
    endforeach()
    foreach(pair "JRR:030001" "JRS:130001")
        string(REPLACE ":" ";" fields "${pair}")
        list(GET fields 0 op)
        list(GET fields 1 opcode)
        check_bytes(forward_${op}_${cpu} ${cpu} " org 256\n ${op} 0,0,target+1000\ntarget equ -740" "${opcode}")
        check_diagnostic(resolved_far_${op}_${cpu} ${cpu} " ${op} 0,0,target+1000\ntarget equ 0" 1370 "branch displacement 997 outside [-128,127] (PC base 0x3)" 3 10)
        check_diagnostic(undefined_${op}_${cpu} ${cpu} " ${op} 0,0,target+1000" 1010 "symbol undefined" 3 10)
    endforeach()
endforeach()

check_diagnostic(acc_mask ST6218 " add x,y" 1350 "allowed addressing forms: A" 3 6)
check_diagnostic(direct_mask ST6218 " ldi (x),0" 1350 "allowed addressing forms: A, V, W, X, Y, expr (DATA), expr (ROM window)" 3 6)
check_diagnostic(bit_count ST6218 "mybit bit 0,1,2" 1110 "expected between 1 and 2 arguments but got 3" 3 "")
check_diagnostic(rom_window ST6218 " assume rombase:0\nrom equ 64,code\n ld a,rom" 110 "ROM address 0x40 uses 64-byte page 1; ASSUME ROMBASE=0" 5 7 0)
check_diagnostic(rom_unknown ST6218 "rom equ 64,code\n ld a,rom" 110 "ROM address 0x40 uses 64-byte page 1; ASSUME ROMBASE=NOTHING" 4 7 0)
check_diagnostic(jp_selected ST6218 " org 0800h\n assume prpr:2\n jp 0" 110 "target address 0x0 uses page 0; allowed pages 1 and 2 (source page 1)" 5 5 0)
check_diagnostic(call_source ST6218 " org 1000h\n call 0" 110 "target address 0x0 uses page 0; allowed pages 1 and 2 (source page 2)" 4 7 0)
check_diagnostic(jp_unknown ST6218 " org 0800h\n assume prpr:nothing\n jp 0" 110 "target address 0x0 uses page 0; only page 1 is known (ASSUME PRPR=NOTHING)" 5 5 0)
check_bytes(warning_window_bytes ST6218 " assume rombase:0\nrom equ 64,code\n ld a,rom" "1f40")
check_bytes(warning_page_bytes ST6218 " org 0800h\n assume prpr:2\n jp 0" "0900")
foreach(pair "JRZ:7c:84" "JRNZ:78:80" "JRC:7e:86" "JRNC:7a:82")
    string(REPLACE ":" ";" fields "${pair}")
    list(GET fields 0 op)
    list(GET fields 1 upper)
    list(GET fields 2 lower)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(upper_${op} ST6218 " ${op} 17" 1370 "branch displacement 16 outside [-16,15] (PC base 0x1)" 3 ${column})
    check_diagnostic(lower_${op} ST6218 " org 16\n ${op} 0" 1370 "branch displacement -17 outside [-16,15] (PC base 0x11)" 4 ${column})
    check_bytes(upper_${op} ST6218 " ${op} 16" "${upper}")
    check_bytes(lower_${op} ST6218 " org 15\n ${op} 0" "${lower}")
endforeach()
foreach(op JRR JRS)
    check_diagnostic(upper_${op} ST6218 " ${op} 0,0,131" 1370 "branch displacement 128 outside [-128,127] (PC base 0x3)" 3 10)
    check_diagnostic(lower_${op} ST6218 " org 126\n ${op} 0,0,0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 10)
endforeach()
