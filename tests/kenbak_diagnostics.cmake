file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(value 4 31 32 33 64 255)
    foreach(op SFTL SFTR ROTL ROTR)
        check_diagnostic(register_${op}_${value} KENBAK " ${op} ${value}" 1445 "invalid register" 3 7)
        check_bytes(reject_register_${op}_${value} KENBAK " expect 1445\n ${op} ${value}\n endexpect\n noop" "80")
    endforeach()
    check_diagnostic(clear_register_${value} KENBAK " clear ${value}" 1445 "invalid register" 3 8)
endforeach()
check_bytes(original KENBAK " sftl a\n sftr b\n rotl 4,a\n rotr 3,b\n clear x\n load a,#255" "8929c1798c0213ff")
check_bytes(register_aliases KENBAK "alias reg a\n sftl alias\n sftl 0\n sftr b\n sftr 1" "89892929")

foreach(op JPD JPI JMD JMI JP JM)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(immediate_jump_${op} KENBAK " ${op} #1" 1350 "allowed addressing forms: expr, A, B, X, P" 3 ${column})
    check_bytes(reject_immediate_jump_${op} KENBAK " expect 1350\n ${op} #1\n endexpect\n noop" "80")
endforeach()
check_diagnostic(immediate_bit_address KENBAK " set0 0,#1" 1350 "allowed addressing forms: expr, A, B, X, P" 3 9)
check_bytes(reject_immediate_bit_address KENBAK " expect 1350\n set0 0,#1\n endexpect\n noop" "80")
check_bytes(valid_jump_modes KENBAK " jpd 1\n jpi 1\n jp 1\n jp (1)" "e301eb01e301eb01")

check_diagnostic(shift_register KENBAK " sftl x" 1445 "operand must be A / 0, B / 1" 3 7)
check_diagnostic(shift_numeric_register KENBAK " sftl 32" 1445 "operand must be A / 0, B / 1" 3 7)
check_diagnostic(index_register KENBAK " load a,1,b" 1445 "operand must be X" 3 11)
check_diagnostic(acc_register KENBAK " or b,#1" 1445 "operand must be A / 0" 3 5)
foreach(op SFTL SFTR ROTL ROTR)
    foreach(count 0 5 7)
        check_diagnostic(count_${op}_${count} KENBAK " ${op} ${count},a" 1380 "${op} argument ${count} outside [1,4]" 3 7)
    endforeach()
endforeach()
foreach(op SHIFT ROTATE)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(direction_${op} KENBAK " ${op} up,a" 1380 "operand must be LEFT, RIGHT" 3 ${column})
    math(EXPR count_column "${length} + 8")
    check_diagnostic(count_${op} KENBAK " ${op} left,0,a" 1380 "${op} argument 0 outside [1,4]" 3 ${count_column})
endforeach()
foreach(op JPD JPI JMD JMI JP JM)
    check_diagnostic(count_${op} KENBAK " ${op} a,1" 1110 "expected 1 or 3 arguments but got 2" 3 "")
endforeach()
check_diagnostic(bit_count KENBAK "mybit bit 0,1,2" 1110 "expected between 1 and 2 arguments but got 3" 3 "")
check_bytes(shift_endpoints KENBAK " sftl 1,a\n sftl 4,b\n sftr 1,a\n sftr 4,b\n rotl 1,a\n rotl 4,b\n rotr 1,a\n rotr 4,b" "89a10921c9e14961")
check_bytes(shift_forward KENBAK " sftl count,a\ncount equ 4" "81")
