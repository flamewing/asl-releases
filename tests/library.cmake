cmake_minimum_required(VERSION 3.19)
file(MAKE_DIRECTORY "${TEST_DIR}")
set(ENV{ASCMD} "")
file(WRITE "${TEST_DIR}/m68k.asm" " cpu 68000\n nop\n dc.b 10,20\n")
file(WRITE "${TEST_DIR}/z80.asm" " cpu z80\n nop\n")
file(WRITE "${TEST_DIR}/default.asm" " nop\n")
file(WRITE "${TEST_DIR}/definitions.asm" " cpu 68000\n ifdef FLAG\n dc.b TEXT,FLAG\n else\n dc.b 42\n endif\n")
file(WRITE "${TEST_DIR}/warning.asm" " cpu 68000\n warning \"library warning\"\n nop\n")
file(WRITE "${TEST_DIR}/include.asm" " cpu 68000\n include \"missing-include.inc\"\n")
file(WRITE "${TEST_DIR}/macro.asm" " cpu 68000\nmac macro\n invalid_opcode\n endm\n mac\n")
file(WRITE "${TEST_DIR}/frames.asm" " cpu 68000\n section demo\n phase 4096\n if 1\n invalid_opcode\n")
file(WRITE "${TEST_DIR}/unfinished.asm" " cpu 68000\nmac macro\n nop\n")
file(WRITE "${TEST_DIR}/structure.asm" " cpu 68000\nthing struct\nfield ds.b 1\n invalid_opcode\n")
file(WRITE "${TEST_DIR}/bracket.asm" " cpu 68000\n move.w (a0,d0],d1\n")
string(ASCII 195 169 utf8_letter)
string(ASCII 233 cp1252_letter)
file(WRITE "${TEST_DIR}/utf8.asm" " cpu 68000\n${utf8_letter} equ 42\n dc.b ${utf8_letter}\n")
file(WRITE "${TEST_DIR}/cp1252.asm" " cpu 68000\n${cp1252_letter} equ 42\n dc.b ${cp1252_letter}\n")
execute_process(COMMAND ${TEST_EMULATOR} "${TEST_PROGRAM}"
    WORKING_DIRECTORY "${TEST_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Library lifecycle: ${result}\n${output}${error}")
endif()

foreach(name IN ITEMS m68k z80 definitions warning utf8 cp1252)
    set(options "")
    if(name STREQUAL "utf8")
        set(options -codepage utf-8)
    elseif(name STREQUAL "cp1252")
        set(options -codepage 1252)
    endif()
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${name}.asm" -q -o "${name}-cli.p" ${options}
        WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "CLI comparison ${name}: ${result}\n${output}${error}")
    endif()
    file(SHA256 "${TEST_DIR}/${name}.p" library_hash)
    file(SHA256 "${TEST_DIR}/${name}-cli.p" cli_hash)
    if(NOT library_hash STREQUAL cli_hash)
        message(FATAL_ERROR "${name}: library object differs from CLI")
    endif()
endforeach()
foreach(name IN ITEMS after-options after-open-error after-macro-error after-frames-error after-unfinished-error after-structure-error after-bracket-error)
    file(SHA256 "${TEST_DIR}/${name}.p" actual)
    file(SHA256 "${TEST_DIR}/m68k-cli.p" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: recovery changed assembled object")
    endif()
endforeach()
foreach(name IN ITEMS no-default warning-error include macro frames unfinished structure bracket stale)
    if(EXISTS "${TEST_DIR}/${name}.p")
        message(FATAL_ERROR "${name}: failed invocation left an object file")
    endif()
endforeach()
