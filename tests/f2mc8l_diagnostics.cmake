file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(op SETB CLRB BBC BBS)
    if(op MATCHES "^B")
        set(target ",3")
        set(column 6)
        set(bit_column 8)
    else()
        set(target "")
        set(column 7)
        set(bit_column 9)
    endif()
    check_diagnostic(address_${op} MB89190 " ${op} 256:0${target}" 1320 "256 > 255" 3 ${column})
    check_diagnostic(bit_${op} MB89190 " ${op} 0:8${target}" 1320 "8 > 7" 3 ${bit_column})
    check_diagnostic(undefined_address_${op} MB89190 " ${op} missing:0${target}" 1010 "symbol undefined" 3 ${column})
    check_diagnostic(undefined_bit_${op} MB89190 " ${op} 0:missing${target}" 1010 "symbol undefined" 3 ${bit_column})
    check_diagnostic(missing_separator_${op} MB89190 " ${op} 0${target}" 1350 "allowed addressing forms: expr (0..255):bit (0..7)" 3 ${column})
    check_bytes(reject_bit_${op} MB89190 " expect 1320\n ${op} 0:8${target}\n endexpect\n nop" "00")
endforeach()
check_bytes(original MB89190 " setb 12h:0\n clrb 34h:7\n bbs 56h:1,$+3\n bbc 78h:2,$+4" "a812a734b95600b27801")

foreach(pair "BEQ:fd" "BZ:fd" "BNZ:fc" "BNE:fc" "BC:f9" "BLO:f9" "BNC:f8" "BHS:f8" "BN:fb" "BP:fa" "BLT:ff" "BGE:fe")
    string(REPLACE ":" ";" fields "${pair}")
    list(GET fields 0 op)
    list(GET fields 1 opcode)
    check_bytes(forward_${op} MB89190 " org 256\n ${op} target+1000\ntarget equ -741" "${opcode}01")
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(resolved_far_${op} MB89190 " ${op} target+1000\ntarget equ 0" 1370 "branch displacement 998 outside [-128,127] (PC base 0x2)" 3 ${column})
    check_diagnostic(undefined_${op} MB89190 " ${op} target+1000" 1010 "symbol undefined" 3 ${column})
endforeach()
foreach(pair "BBC:b00001" "BBS:b80001")
    string(REPLACE ":" ";" fields "${pair}")
    list(GET fields 0 op)
    list(GET fields 1 opcode)
    check_bytes(forward_${op} MB89190 " org 256\n ${op} 0:0,target+1000\ntarget equ -740" "${opcode}")
    check_diagnostic(resolved_far_${op} MB89190 " ${op} 0:0,target+1000\ntarget equ 0" 1370 "branch displacement 997 outside [-128,127] (PC base 0x3)" 3 10)
    check_diagnostic(undefined_${op} MB89190 " ${op} 0:0,target+1000" 1010 "symbol undefined" 3 10)
endforeach()

foreach(pair "a:1401" "12h:951201" "@ix+2:960201" "@ep:9701" "r0:9801" "r7:9f01")
    string(REPLACE ":" ";" fields "${pair}")
    list(GET fields 0 operand)
    list(GET fields 1 expected)
    check_bytes(cmp_byte_${operand} MB89190 " cmp ${operand},#1" "${expected}")
    check_bytes(cmp_after_word_${operand} MB89190 " movw a,#1234h\n cmp ${operand},#1" "e43412${expected}")
    string(LENGTH "${operand}" length)
    math(EXPR column "8 + ${length}")
    check_diagnostic(cmp_overflow_${operand} MB89190 " movw a,#1234h\n cmp ${operand},#256" 1320 "256 > 255" 4 ${column})
endforeach()
check_bytes(cmp_forward_after_word MB89190 " movw a,#1234h\n cmp a,#value\nvalue equ 1" "e434121401")
check_bytes(cmp_before_and_after_word MB89190 " cmp a,#1\n movw a,#1234h\n cmp a,#1" "1401e434121401")

check_diagnostic(acc_mask MB89190 " xor r0,#1" 1350 "allowed addressing forms: A" 3 6)
check_diagnostic(word_mask MB89190 " movw a,r0" 1350 "#expr (-32768..65535)" 3 9)
check_diagnostic(byte_mask MB89190 " mov a,t" 1350 "#expr (-128..255)" 3 8)
check_diagnostic(jump_mask MB89190 " jmp #1" 1350 "allowed addressing forms: expr (0..65535), @A" 3 6)
check_diagnostic(stack_mask MB89190 " pushw sp" 1445 "operand must be A, IX" 3 8)
check_diagnostic(stack_mask_pop MB89190 " popw ep" 1445 "operand must be A, IX" 3 7)
check_bytes(operand_original MB89190 " mov a,#255\n movw a,#1234h\n mov a,@ix-1\n pushw ix\n popw ix\n mov a,1000h" "04ffe4341206ff4151600010")
foreach(op BEQ BZ BNZ BNE BC BLO BNC BHS BN BP BLT BGE)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(upper_${op} MB89190 " ${op} 130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 ${column})
    check_diagnostic(lower_${op} MB89190 " org 127\n ${op} 0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 ${column})
endforeach()
foreach(op BBC BBS)
    check_diagnostic(upper_${op} MB89190 " ${op} 0:0,131" 1370 "branch displacement 128 outside [-128,127] (PC base 0x3)" 3 10)
    check_diagnostic(lower_${op} MB89190 " org 126\n ${op} 0:0,0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 10)
endforeach()
check_bytes(upper_edge MB89190 " beq 129" "fd7f")
check_bytes(lower_edge MB89190 " org 126\n beq 0" "fd80")
check_bytes(wrap MB89190 " beq 65535" "fdfd")

