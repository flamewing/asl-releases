file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu 320C50 320C51 320C53)
    foreach(op LAMM SAMM)
        foreach(value 128 -1)
            if(value EQUAL -1)
                set(actual 65535)
            else()
                set(actual 128)
            endif()
            check_diagnostic(address_${op}_${value}_${cpu} ${cpu} " ${op} ${value}" 1320 "address argument ${actual} outside [0,127]" 3 7)
        endforeach()
    endforeach()
    foreach(op LMMR SMMR)
        check_diagnostic(address_${op}_${cpu} ${cpu} " ${op} 128,#1" 1320 "address argument 128 outside [0,127]" 3 7)
    endforeach()
    check_diagnostic(sst_${cpu} ${cpu} " sst #1,128" 1320 "address argument 128 outside [0,127]" 3 9)
    check_diagnostic(xc_low_${cpu} ${cpu} " xc 0,eq" 1315 "XC argument 0 outside [1,2]" 3 5)
    check_diagnostic(xc_high_${cpu} ${cpu} " xc 3,eq" 1320 "XC argument 3 outside [1,2]" 3 5)
    check_diagnostic(bit_${cpu} ${cpu} " setc invalid" 1445 "operand must be OVM, SXM, HM, TC, C, XF, CNF, INTM" 3 7)
    check_diagnostic(bldd_${cpu} ${cpu} " bldd *,*" 1350 "allowed addressing forms: #expr, BMAR (either operand)" 3 7)
    check_diagnostic(blpd_${cpu} ${cpu} " blpd *,*" 1350 "allowed addressing forms: #expr, BMAR" 3 7)
    check_diagnostic(norm_${cpu} ${cpu} " norm 1" 1350 "allowed addressing forms: *-, *+, *BR0-, *0-, *AR0-, *0+, *AR0+, *BR0+, *" 3 7)
endforeach()
check_diagnostic(old_bit 320C203 " clrc invalid" 1445 "operand must be OVM, SXM, TC, C, XF, CNF, INTM" 3 7)
check_diagnostic(old_bldd 320C203 " bldd *,*" 1350 "allowed addressing forms: #expr (either operand)" 3 7)
check_diagnostic(old_blpd 320C203 " blpd *,*" 1350 "allowed addressing forms: #expr" 3 7)
foreach(op B BANZ CALL)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 9")
    check_diagnostic(branch_${op} 320C203 " ${op} 1234h,1" 1350 "allowed addressing forms: *-, *+, *BR0-, *0-, *0+, *BR0+, *" 3 ${column})
endforeach()
check_diagnostic(undefined_address 320C50 " lamm missing" 1010 "symbol undefined" 3 7)
check_bytes(original 320C50 " lamm 0\n samm 127\n lmmr 127,#1234h\n smmr *,#1234h,ar7\n sst #1,127\n b 1234h,*+,ar7\n norm *-\n bldd #1234h,*\n bldd *,#1234h\n blpd bmar,*\n setc hm\n xc 1,eq\n xc 2,c" "00087f887f8934128f0934127f8faf79341290a080a8341280a9341280a449be88e711f7")


foreach(op BCND BCNDD CC CCD)
    string(LENGTH "${op}" length)
    math(EXPR first "${length} + 9")
    math(EXPR second "${first} + 3")
    check_diagnostic(unknown_condition_${op} 320C50 " ${op} 1234h,invalid" 1360 "undefined condition" 3 ${first})
    check_diagnostic(duplicate_condition_${op} 320C50 " ${op} 1234h,eq,neq" 1360 "undefined condition" 3 ${second})
    check_bytes(reject_condition_${op} 320C50 " expect 1360\n ${op} 1234h,invalid\n endexpect\n nop\n expect 1360\n ${op} 1234h,eq,neq\n endexpect\n nop" "008b008b")
endforeach()
foreach(op RETC RETCD)
    string(LENGTH "${op}" length)
    math(EXPR first "${length} + 3")
    math(EXPR second "${first} + 3")
    check_diagnostic(unknown_condition_${op} 320C50 " ${op} invalid" 1360 "undefined condition" 3 ${first})
    check_diagnostic(duplicate_condition_${op} 320C50 " ${op} eq,neq" 1360 "undefined condition" 3 ${second})
    check_bytes(reject_condition_${op} 320C50 " expect 1360\n ${op} invalid\n endexpect\n nop\n expect 1360\n ${op} eq,neq\n endexpect\n nop" "008b008b")
endforeach()
check_diagnostic(unknown_condition_XC 320C50 " xc 1,invalid" 1360 "undefined condition" 3 7)
check_diagnostic(duplicate_condition_XC 320C50 " xc 1,eq,neq" 1360 "undefined condition" 3 10)
check_bytes(reject_condition_XC 320C50 " expect 1360\n xc 1,invalid\n endexpect\n nop\n expect 1360\n xc 1,eq,neq\n endexpect\n nop" "008b008b")
foreach(pair "c,nc" "ov,nov" "tc,ntc")
    string(FIND "${pair}" "," comma)
    math(EXPR column "8 + ${comma}")
    check_diagnostic(duplicate_${pair} 320C50 " retc ${pair}" 1360 "undefined condition" 3 ${column})
endforeach()
