file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(transfer XGATE " tfr r0,r1" 1350 "allowed addressing forms: (R0..R7,CCR), (CCR,R0..R7), (R0..R7,PC)" 3 6)
foreach(op LDB STB STW)
    check_diagnostic(immediate_${op} XGATE " ${op} r0,#1" 1350 "allowed addressing forms: (Rn,#expr), (Rn,Rm), (Rn,-Rm), (Rn,Rm+)" 3 9)
endforeach()
foreach(op LDB LDW STB STW)
    if(op STREQUAL "LDW")
        set(prefix "#expr, ")
    else()
        set(prefix "")
    endif()
    check_diagnostic(memory_${op} XGATE " ${op} r0,1" 1350 "allowed addressing forms: ${prefix}(Rn,#expr)" 3 9)
endforeach()
check_diagnostic(odd_instruction XGATE " org 1\n nop" 180 "instruction address 0x1 must be aligned to 2 bytes" 4 2 0)
foreach(op BCC BCS BEQ BGE BGT BHI BHS BLE BLO BLS BLT BMI BNE BPL BVC BVS BRA)
    if(op STREQUAL "BRA")
        set(minimum -1024)
        set(maximum 1022)
        set(pc 1024)
        set(target 1026)
    else()
        set(minimum -512)
        set(maximum 510)
        set(pc 512)
        set(target 514)
    endif()
    math(EXPR high "${maximum}+2")
    math(EXPR low "${minimum}-2")
    check_diagnostic(upper_${op} XGATE " ${op} ${target}" 1370 "branch displacement ${high} outside [${minimum},${maximum}] (PC base 0x2); must be a multiple of 2" 3 6)
    check_diagnostic(lower_${op} XGATE " org ${pc}\n ${op} 0" 1370 "branch displacement ${low} outside [${minimum},${maximum}]" 4 6)
    check_diagnostic(odd_${op} XGATE " ${op} 3" 1325 "branch displacement 1 must be a multiple of 2 (PC base 0x2)" 3 6)
endforeach()
check_bytes(original XGATE " tfr r2,ccr\n tfr ccr,r5\n tfr r4,pc\n ldw r5,#$1234\n ldb r5,(r1,#20)\n ldw r5,(r4,r2+)\n stw r5,(r2,-r1)\n bra *\n bne *" "02f805f904faf534fd1245346d897d463fff25ff")
check_bytes(short_upper XGATE " bne 512" "24ff")
check_bytes(short_lower XGATE " org 510\n bne 0" "2500")
check_bytes(long_upper XGATE " bra 1024" "3dff")
check_bytes(long_lower XGATE " org 1022\n bra 0" "3e00")
check_bytes(zero XGATE " bra 2" "3c00")
check_bytes(forward XGATE " bra target\n nop\ntarget: nop" "3c0101000100")
check_diagnostic(undefined XGATE " bra missing" 1010 "symbol undefined" 3 6)
