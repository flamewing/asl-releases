file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(primary_register CP-1600 " incr missing" 1445 "invalid register" 3 7)
check_diagnostic(primary_syntax CP-1600 " incr #1" 1445 "invalid register" 3 7)
check_diagnostic(primary_integer CP-1600 " incr 1" 1445 "register" 3 7)
check_diagnostic(primary_bext CP-1600 " bext 2,16" 1320 "16 > 15" 3 9)
check_bytes(reject_bext CP-1600 " expect 1320\n bext 2,16\n endexpect\n word 4660" "1234")
check_bytes(bext_original CP-1600 " bext 2,15" "021f0000")
check_bytes(aliases CP-1600 "tmp reg r2\n incr tmp\n incr sp\n incr pc" "000a000e000f")

set(shift_ops SWAP SLL RLC SLLC SLR SAR RRC SARC)
set(shift_codes 0040 0048 0050 0058 0060 0068 0070 0078)
foreach(index RANGE 0 7)
    list(GET shift_ops ${index} op)
    list(GET shift_codes ${index} code)
    check_bytes(forward_count_${op} CP-1600 " ${op} r0,target\ntarget equ 1" "${code}")
endforeach()
check_bytes(forward_nop CP-1600 " nop target\ntarget equ 2" "0035")
check_bytes(forward_sin CP-1600 " sin target\ntarget equ 2" "0037")
check_bytes(forward_mvo CP-1600 " bits 10\n mvo r1,target+5000\ntarget equ -4999" "02410001")
check_bytes(forward_mvoi CP-1600 " bits 10\n mvoi r1,target+5000\ntarget equ -4999" "02790001")
check_bytes(forward_mvi CP-1600 " bits 10\n mvi target+5000,r1\ntarget equ -4999" "02810001")
check_bytes(forward_mvoi_range CP-1600 " mvoi r1,target+80000\ntarget equ -79999" "02790001")
check_bytes(forward_prefix_range CP-1600 " sdbd\n mvii target+80000,r1\ntarget equ -79999" "000102b900010000")
check_bytes(forward_branch CP-1600 " bits 10\n org 2048\n b target+5000\ntarget equ -2950" "02000000")
check_bytes(forward_bext CP-1600 " bits 10\n org 2048\n bext target+5000,condition\ntarget equ -2950\ncondition equ 15" "021f0000")
