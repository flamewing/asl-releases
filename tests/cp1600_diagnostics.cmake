    math(EXPR overflow "${max}+1")
    check_diagnostic(mvo_field_${bits} CP-1600 " bits ${bits}\n mvo r1,${overflow}" 1320 "word value ${overflow} outside [0,${max}] for BITS ${bits}" 4 9)
    check_diagnostic(mvoi_field_${bits} CP-1600 " bits ${bits}\n mvoi r1,${overflow}" 1320 "word value ${overflow} outside [0,${max}] for BITS ${bits}" 4 10)
    check_diagnostic(mvoi_negative_${bits} CP-1600 " bits ${bits}\n mvoi r1,-1" 1320 "word value -1 outside [0,${max}] for BITS ${bits}" 4 10)
    check_diagnostic(mvi_field_${bits} CP-1600 " bits ${bits}\n mvi ${overflow},r1" 1320 "word value ${overflow} outside [0,${max}] for BITS ${bits}" 4 6)
endforeach()
