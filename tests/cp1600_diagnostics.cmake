foreach(op WORD BYTE TEXT)
    if(op STREQUAL "TEXT")
        set(lower -1)
        set(upper 256)
    else()
        set(lower -32769)
        set(upper 65536)
    endif()
    check_bytes(partial_lower_${op} CP-1600 " expect 1315\n ${op} 1,${lower},2\n endexpect\n word 4660" "1234")
    check_bytes(partial_upper_${op} CP-1600 " expect 1320\n ${op} 1,${upper},2\n endexpect\n word 4660" "1234")
    string(LENGTH "${op}" op_length)
    math(EXPR value_column "${op_length}+5")
    check_diagnostic(range_position_${op} CP-1600 " ${op} 1,${upper},missing" 1320 "${upper} > " 3 ${value_column})
endforeach()
