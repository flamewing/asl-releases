file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()





check_diagnostic(condition_field_underflow MPC601 " cmp -1,r1,r2" 1315 "-1 < 0" 3 6)
check_diagnostic(condition_field_type MPC601 " cmp 1.5,r1,r2" 1133 "expected integer" 3 6)
check_bytes(condition_failure_noemit MPC601 " expect 1315,1133\n cmp -1,r1,r2\n cmp 1.5,r1,r2\n endexpect\n db 0x12" "12")
check_bytes(original_primary_paths MPC601 " cmp 0,r1,r2\n cmp 7,r1,r2\n add r1,r2,r3\n fadd fr1,fr2,fr3" "7c0110007f8110007c221a14fc22182a")
check_diagnostic(integer_nonregister MPC601 "value equ 1\n add r1,r2,value" 1147 "expected register" 4 12)
check_diagnostic(float_nonregister MPC601 "value equ 1\n fadd fr1,fr2,value" 1147 "expected register" 4 15)

foreach(cpu PPC403 PPC403GC MPC505 MPC601 MPC821 RS6000)
    set(body "")
    set(definitions "")
    set(expected "")
    set(pc 0)
    foreach(pair B:48000000 BL:48000001 BA:48000002 BLA:48000003 BC:42800000 BCL:42800001 BCA:42800002 BCLA:42800003)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 op)
        list(GET parts 1 bytes)
        if(op MATCHES "^BC")
            set(prefix "20,0,")
        else()
            set(prefix "")
        endif()
        set(index 0)
        foreach(offset 1001 1000000000 -1001 -1000000000)
            if(op STREQUAL "BA" OR op STREQUAL "BLA" OR op STREQUAL "BCA" OR op STREQUAL "BCLA")
                set(desired 0)
            else()
                set(desired "${pc}")
            endif()
            if(offset LESS 0)
                set(sign "-")
                math(EXPR magnitude "0 - ${offset}")
            else()
                set(sign "+")
                set(magnitude "${offset}")
            endif()
            math(EXPR value "${desired} - ${offset}")
            string(APPEND body " ${op} ${prefix}target_${op}_${index}${sign}${magnitude}\n")
            string(APPEND definitions "target_${op}_${index} equ ${value}\n")
            string(APPEND expected "${bytes}")
            math(EXPR pc "${pc} + 4")
            math(EXPR index "${index} + 1")
        endforeach()
    endforeach()
    check_bytes(forward_branch_constraints_${cpu} ${cpu} "${body}${definitions}" "${expected}")
    check_diagnostic(final_branch_alignment_${cpu} ${cpu} " b target\ntarget equ 1" 1375 "branch displacement 1 must be a multiple of 4" 3 4)
    check_diagnostic(final_branch_range_${cpu} ${cpu} " b target\ntarget equ 33554432" 1320 "branch displacement 33554432 outside [-33554432,33554428]" 3 4)
    check_diagnostic(final_conditional_alignment_${cpu} ${cpu} " bc 20,0,target\ntarget equ 1" 1375 "branch displacement 1 must be a multiple of 4" 3 10)
    check_diagnostic(final_conditional_range_${cpu} ${cpu} " bc 20,0,target\ntarget equ 32768" 1320 "branch displacement 32768 outside [-32768,32764]" 3 10)
endforeach()
