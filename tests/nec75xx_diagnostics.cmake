file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(op LAM XAM)
    check_diagnostic(pr_7566_${op} 7566 " ${op} dl" 1350 "allowed addressing forms: HL-, HL+, HL" 3 6)
    check_diagnostic(pr_7508_${op} 7508 " ${op} h" 1350 "allowed addressing forms: HL-, HL+, HL, DL, DE" 3 6)
endforeach()
foreach(target 0ffh 108h 13fh 148h 17fh 188h 1bfh 1c8h 200h 3ffh)
    check_diagnostic(cal_${target} 7566 " cal ${target}" 1320 "must be in [0x100,0x107], [0x140,0x147], [0x180,0x187] or [0x1c0,0x1c7]" 3 6)
endforeach()
check_diagnostic(cal_value 7566 " cal 108h" 1320 "CAL target 0x108" 3 6)
foreach(entry LHLT:192:207 CALT:208:255)
    string(REPLACE ":" ";" parts "${entry}")
    list(GET parts 0 op)
    list(GET parts 1 minimum)
    list(GET parts 2 maximum)
    math(EXPR lower "${minimum}-1")
    math(EXPR upper "${maximum}+1")
    check_diagnostic(lower_${op} 7508 " ${op} ${lower}" 1320 "${op} argument ${lower} outside [${minimum},${maximum}]" 3 7)
    check_diagnostic(upper_${op} 7508 " ${op} ${upper}" 1320 "${op} argument ${upper} outside [${minimum},${maximum}]" 3 7)
endforeach()
check_diagnostic(cal_undefined 7566 " cal missing" 1010 "symbol undefined" 3 6)
check_diagnostic(lhlt_undefined 7508 " lhlt missing" 1010 "symbol undefined" 3 7)
check_diagnostic(calt_guess_bug 7508 " calt missing" 1320 "CALT argument 192 outside [208,255]" 3 7)
check_bytes(original_7566 7566 " lam hl-\n lam hl+\n lam hl\n cal 100h\n cal 107h\n cal 140h\n cal 147h\n cal 180h\n cal 187h\n cal 1c0h\n cal 1c7h" "505152e0e7e8eff0f7f8ff")
check_bytes(original_7508 7508 " lam dl\n lam de\n lam hl\n lhlt 0c0h\n lhlt 0cfh\n calt 0d0h\n calt 0ffh" "404152c0cfd0ff")
check_bytes(forward 7566 " cal target\ntarget equ 1c7h" "ff")
set(ENV{LC_MESSAGES} de)
