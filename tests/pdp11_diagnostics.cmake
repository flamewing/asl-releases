file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu PDP-11/94 WD16)
    string(REPLACE "/" "_" tag "${cpu}")
    check_diagnostic(sob_underflow_${tag} ${cpu} " sob r1,-1" 1315 "-1 < 0" 3 9)
    check_diagnostic(sob_overflow_${tag} ${cpu} " sob r1,65536" 1320 "65536 > 65535" 3 9)
    check_diagnostic(sob_syntax_${tag} ${cpu} " sob r1,#1" 1020 "invalid symbol name" 3 9)
    check_diagnostic(sob_odd_${tag} ${cpu} " sob r1,1" 1375 "jump target or displacement" 3 9)
    check_diagnostic(sob_far_${tag} ${cpu} " org 256\n sob r1,0" 1370 "jump distance too big" 4 9)
    check_bytes(sob_no_emission_${tag} ${cpu} " expect 1320\n sob r1,65536\n endexpect\n word 0x1234" "3412")
    if(cpu STREQUAL "WD16")
        set(code 76)
    else()
        set(code 7e)
    endif()
    check_bytes(sob_endpoints_${tag} ${cpu} " org 256\n sob r1,132\n sob r1,260" "7f${code}40${code}")
    check_bytes(sob_forward_${tag} ${cpu} " org 256\n sob r1,target+1001\ntarget equ -743" "40${code}")
endforeach()

foreach(cpu PDP-11/94 WD16)
    string(REPLACE "/" "_" tag "${cpu}")
    check_diagnostic(branch_odd_${tag} ${cpu} " br 3" 1375 "branch displacement 1 must be a multiple of 2 (PC base 0x2)" 3 5)
    check_diagnostic(branch_upper_${tag} ${cpu} " br 258" 1370 "branch displacement 256 outside [-256,254] (PC base 0x2); must be a multiple of 2" 3 5)
    check_diagnostic(branch_lower_${tag} ${cpu} " org 256\n br 0" 1370 "branch displacement -258 outside [-256,254] (PC base 0x102); must be a multiple of 2" 4 5)
    check_diagnostic(sob_detail_${tag} ${cpu} " org 256\n sob r1,130" 1370 "branch displacement -128 outside [-126,0] (PC base 0x102); must be a multiple of 2" 4 9)
    check_diagnostic(sob_alignment_${tag} ${cpu} " sob r1,1" 1375 "branch displacement -1 must be a multiple of 2 (PC base 0x2)" 3 9)
    check_diagnostic(reg_required_${tag} ${cpu} " sob (r0),0" 1350 "allowed addressing forms: %0..%7" 3 6)
    if(cpu STREQUAL "WD16")
        set(supervisor "")
        set(alignment_line 5)
        set(padding_bytes 000400)
    else()
        set(supervisor " supmode on\n")
        set(alignment_line 6)
        set(padding_bytes 000000)
    endif()
    check_diagnostic(code_alignment_${tag} ${cpu} "${supervisor} padding off\n org 1\n halt" 180 "instruction address 0x1 must be aligned to 2 bytes" ${alignment_line} 2 0)
    check_bytes(code_padding_${tag} ${cpu} "${supervisor} padding on\n org 1\n halt" "${padding_bytes}")
endforeach()
check_diagnostic(immediate_disallowed PDP-11/94 " mov r0,#1" 1350 "target (also deferred with @)" 3 9)
check_diagnostic(ac_subset PDP-11/94 " addf ac1,ac4" 1350 "operand must be AC0..AC3" 3 11)
check_diagnostic(cis_increment PDP-11/44 " cis on\n l2dr (r1)" 1350 "allowed addressing forms: (Rn)+" 4 7)
check_diagnostic(wd16_floating_indirect WD16 " fadd (r1)+,(r2)" 1350 "allowed addressing forms: (Rn) / @(Rn) / @0(Rn)" 3 7)
check_diagnostic(optional_disabled PDP-11/03 " eis off\n mul r1,r2" 1500 "EIS extension is disabled; use EIS ON to enable it" 4 2)
check_diagnostic(cpu_feature PDP-11/20 " mfpt" 1500 "supported only by PDP-11/23" 3 2)
check_bytes(addressing_original PDP-11/94 " mov r1,r2\n mov #1,r2\n mov @#256,r2\n mov (r1)+,-(r2)\n mov 2(r1),4(r2)" "4210c2150100c21700016214721c02000400")
check_bytes(fp_original PDP-11/94 " addf ac1,ac3\n addf #1.0,ac3" "c1f4d7f480400000")
check_bytes(cis_original PDP-11/44 " cis on\n l2dr (r1)+" "117c")
check_bytes(wd16_original WD16 " fadd (r1),(r2)\n fadd @(r1),@0(r2)" "12f09af0")
