file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


set(relative_ops JMP JC JEQ JG JGE JHS JL JLE JLO JN JNC JNE JNV JNZ JP JPZ JV JZ)
set(relative_codes 00 03 02 0e 0d 0b 09 0a 0f 01 07 06 0c 06 04 05 08 02)
foreach(index RANGE 0 17)
    list(GET relative_ops ${index} op)
    list(GET relative_codes ${index} code)
    check_bytes(forward_${op} 370C010 " org 256\n ${op} target+1000\ntarget equ -741" "${code}01")
endforeach()
foreach(cpu 370C010 370C020 370C030 370C040 370C050)
    check_bytes(forward_BTJO_${cpu} ${cpu} " org 256\n btjo b,a,target+1000\ntarget equ -741" "6601")
    check_bytes(forward_BTJZ_${cpu} ${cpu} " org 256\n btjz b,a,target+1000\ntarget equ -741" "6701")
    check_bytes(forward_DJNZ_${cpu} ${cpu} " org 256\n djnz b,target+1000\ntarget equ -741" "ca01")
    check_bytes(forward_JBIT0_${cpu} ${cpu} " org 256\n jbit0 0,a,target+1000\ntarget equ -739" "77010001")
    check_bytes(forward_JBIT1_${cpu} ${cpu} " org 256\n jbit1 0,a,target+1000\ntarget equ -739" "76010001")
endforeach()

foreach(op IN LISTS relative_ops)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(upper_${op} 370C010 " ${op} 130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 ${column})
    check_diagnostic(lower_${op} 370C010 " org 127\n ${op} 0" 1370 "branch displacement -129 outside [-128,127] (PC base 0x81)" 4 ${column})
endforeach()
foreach(op BTJO BTJZ)
    check_diagnostic(short_${op} 370C010 " ${op} b,a,130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 11)
    check_diagnostic(immediate_${op} 370C010 " ${op} #1,a,131" 1370 "branch displacement 128 outside [-128,127] (PC base 0x3)" 3 12)
    check_diagnostic(register_${op} 370C010 " ${op} #1,r2,132" 1370 "branch displacement 128 outside [-128,127] (PC base 0x4)" 3 13)
endforeach()
check_diagnostic(djnz_acc 370C010 " djnz a,130" 1370 "branch displacement 128 outside [-128,127] (PC base 0x2)" 3 9)
check_diagnostic(djnz_reg 370C010 " djnz r2,131" 1370 "branch displacement 128 outside [-128,127] (PC base 0x3)" 3 10)
foreach(op JBIT0 JBIT1)
    check_diagnostic(branch_${op} 370C010 " ${op} 0,a,132" 1370 "branch displacement 128 outside [-128,127] (PC base 0x4)" 3 12)
    check_diagnostic(packed_branch_${op} 370C010 " ${op} 100h,0" 1350 "bit operand address 0x100 outside [0x0,0xff] or [0x1000,0x10ff]" 3 8)
endforeach()
foreach(op CMPBIT SBIT0 SBIT1)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(packed_${op} 370C010 " ${op} 100h" 1350 "bit operand address 0x100 outside [0x0,0xff] or [0x1000,0x10ff]" 3 ${column})
    math(EXPR column "${length} + 5")
    check_diagnostic(address_${op} 370C010 " ${op} 0,1100h" 1350 "bit operand address 0x1100 outside [0x0,0xff] or [0x1000,0x10ff]" 3 ${column})
endforeach()
check_diagnostic(address_forms 370C010 " br #1" 1350 "allowed addressing forms: expression; expression(B); @Rn; disp(Rn)" 3 5)
check_diagnostic(immediate_forms 370C010 " cmp p1,b" 1350 "allowed addressing forms: R0..R255 / 0..255 / A / B; #expression (-128..255)" 3 6)
check_diagnostic(status_register 370C010 " inc st" 1350 "allowed addressing forms: A; B; R0..R255 / 0..255 / A / B" 3 6)
check_bytes(original 370C010 " mov b,a\n mov #1,b\n mov r2,r3\n movw #1234h,r4\n br 1234h\n br @r4\n push st\n jmp 17\n jbit0 0,a,22" "625201420203881234048c12349c04fb00ff77010000")
check_bytes(upper 370C010 " jmp 129" "007f")
check_bytes(lower 370C010 " org 126\n jmp 0" "0080")
check_bytes(wrapped 370C010 " jmp 65535" "00fd")
