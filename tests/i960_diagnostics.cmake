file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()


foreach(op LD LDOB LDOS LDA LDL LDT LDQ LDIB LDIS BALX)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(overflow_${op} 80960 " ${op} 4294967296,r0" 1320 "4294967296 > 4294967295" 3 ${column})
    check_diagnostic(undefined_${op} 80960 " ${op} missing,r0" 1010 "symbol undefined" 3 ${column})
    check_bytes(reject_${op} 80960 " expect 1320\n ${op} 4294967296,r0\n endexpect\n word 12345678h" "78563412")
endforeach()
foreach(op ST STOB STOS STL STT STQ STIB STIS)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 6")
    check_diagnostic(overflow_${op} 80960 " ${op} r0,4294967296" 1320 "4294967296 > 4294967295" 3 ${column})
    check_bytes(reject_${op} 80960 " expect 1320\n ${op} r0,4294967296\n endexpect\n word 12345678h" "78563412")
endforeach()
foreach(op BX CALLX)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(overflow_${op} 80960 " ${op} 4294967296" 1320 "4294967296 > 4294967295" 3 ${column})
    check_bytes(reject_${op} 80960 " expect 1320\n ${op} 4294967296\n endexpect\n word 12345678h" "78563412")
endforeach()
check_bytes(original 80960 " ld 0,r0\n ld 4095(r1),r2\n ld 4096,r3\n ld 32(ip),r4" "00000090ff6f109000301890001000000014209008000000")

set(control_ops B CALL BAL BNO BG BE BGE BL BNE BLE BO)
set(control_codes 08 09 0b 19 11 12 13 14 15 16 17)
foreach(index RANGE 0 10)
    list(GET control_ops ${index} op)
    list(GET control_codes ${index} code)
    check_bytes(forward_${op} 80960 " ${op} target+10000000\ntarget equ -9999996" "040000${code}")
endforeach()
set(cobr_ops BBC BBS CMPIBE CMPOBE CMPIBNE CMPOBNE CMPIBL CMPOBL CMPIBLE CMPOBLE CMPIBG CMPOBG CMPIBGE CMPOBGE CMPIBO CMPIBNO)
set(cobr_codes 30 37 3a 32 3d 35 3c 34 3e 36 39 31 3b 33 3f 38)
foreach(index RANGE 0 15)
    list(GET cobr_ops ${index} op)
    list(GET cobr_codes ${index} code)
    check_bytes(forward_${op} 80960 " ${op} r0,r1,target+8192\ntarget equ -8188" "044000${code}")
endforeach()

foreach(op MOVL MOVT MOVQ MOVRL MOVRE)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    if(op STREQUAL "MOVL" OR op STREQUAL "MOVRL")
        set(multiple 2)
    else()
        set(multiple 4)
    endif()
    check_diagnostic(group_${op} 80960 " fpu on\n ${op} r1,r4" 1760 "register number 1 must be a multiple of ${multiple}" 4 ${column})
endforeach()
foreach(op LDL STL LDT STT LDQ STQ)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 5")
    if(op MATCHES "^ST")
        set(body " ${op} r1,0")
        math(EXPR column "${length} + 3")
    else()
        set(body " ${op} 0,r1")
    endif()
    if(op STREQUAL "LDL" OR op STREQUAL "STL")
        set(multiple 2)
    else()
        set(multiple 4)
    endif()
    check_diagnostic(group_${op} 80960 "${body}" 1445 "register number 1 must be a multiple of ${multiple}" 3 ${column})
endforeach()
check_diagnostic(float_constant 80960 " fpu on\n movr 2.0,fp0" 1320 "constant 2 not allowed; accepted constants: 0.0 / 1.0" 4 7)
check_diagnostic(integer_forms 80960 " fpu on\n mov fp0,r1" 1350 "allowed addressing forms: R0..R15 / G0..G15 (FP/PFP/SP/RIP); 0..31" 4 6)
check_diagnostic(register_only 80960 " mov r0,1" 1350 "allowed addressing forms: R0..R15 / G0..G15 (FP/PFP/SP/RIP)" 3 9)
check_diagnostic(float_register_only 80960 " fpu on\n movr fp0,1.0" 1350 "allowed addressing forms: R0..R15 / G0..G15 (FP/PFP/SP/RIP); FP0..FP3" 4 11)
foreach(scale 0 3 32 64 -1 4294967297 999999999999999999999999 bad)
    check_diagnostic(scale_${scale} 80960 " ld 0[r0*${scale}],r1" 1350 "index scale ${scale} not allowed; accepted scales: 1,2,4,8,16" 3 10)
endforeach()
check_diagnostic(repeat_index 80960 " ld 0[r0][r1],r2" 1350 "address contains more than one index register" 3 5)
check_diagnostic(repeat_base 80960 " ld 0(r0)(r1),r2" 1350 "address contains more than one base register" 3 5)
check_diagnostic(ip_index 80960 " ld 0(ip)[r1],r2" 1350 "IP-relative addressing cannot use an index register" 3 5)
check_diagnostic(instruction_alignment 80960 " org 1\n ret" 180 "instruction address 0x1 must be aligned to 4 bytes" 4 2 0)
foreach(op IN LISTS control_ops)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 3")
    check_diagnostic(alignment_${op} 80960 " ${op} 2" 1325 "branch displacement 2 must be a multiple of 4 (PC base 0x0)" 3 ${column})
    check_diagnostic(upper_${op} 80960 " ${op} 8388608" 1370 "branch displacement 8388608 outside [-8388608,8388604] (PC base 0x0); must be a multiple of 4" 3 ${column})
    check_diagnostic(lower_${op} 80960 " org 8388612\n ${op} 0" 1370 "branch displacement -8388612 outside [-8388608,8388604] (PC base 0x800004); must be a multiple of 4" 4 ${column})
endforeach()
foreach(op IN LISTS cobr_ops)
    string(LENGTH "${op}" length)
    math(EXPR column "${length} + 9")
    check_diagnostic(alignment_${op} 80960 " ${op} r0,r1,2" 1325 "branch displacement 2 must be a multiple of 4 (PC base 0x0)" 3 ${column})
    check_diagnostic(upper_${op} 80960 " ${op} r0,r1,4092" 1370 "branch displacement 4092 outside [-4096,4088] (PC base 0x0); must be a multiple of 4" 3 ${column})
    check_diagnostic(lower_${op} 80960 " org 4100\n ${op} r0,r1,0" 1370 "branch displacement -4100 outside [-4096,4088] (PC base 0x1004); must be a multiple of 4" 4 ${column})
endforeach()
