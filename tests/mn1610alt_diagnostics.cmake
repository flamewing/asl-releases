file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu MN1610ALT MN1613ALT)
    check_diagnostic(register_${cpu} ${cpu} " mv ic,r0" 1445 "operand must be R0 / R1 / R2 / R3 / R4 / SP / STR / X0 / X1" 3 5)
    check_diagnostic(memory_register_${cpu} ${cpu} " l str,0" 1445 "operand must be R0 / R1 / R2 / R3 / R4 / SP / X0 / X1" 3 4)
    check_diagnostic(shift_extension_${cpu} ${cpu} " sl r0,bad,skp" 1445 "operand must be RE / SE / CE" 3 8)
    check_diagnostic(ic_indirect_${cpu} ${cpu} " l r0,(10)(ic)" 1350 "allowed addressing forms: disp(IC) / (disp(IC))" 3 7)
    check_diagnostic(x_indirect_${cpu} ${cpu} " l r0,(10(x0))" 1350 "allowed addressing forms: disp(X0) / (disp)(X0) / disp(X1) / (disp)(X1)" 3 7)
    check_diagnostic(zero_offset_${cpu} ${cpu} " l r0,<256" 1320 "address 0x100 gives segment offset 0x100 outside [0,0xFF] with CSBR=0 (base 0x0)" 3 7)
    check_diagnostic(relative_upper_${cpu} ${cpu} " l r0,>128" 1330 "address displacement 128 outside [-128,127] (PC base 0x0)" 3 7)
    check_diagnostic(relative_lower_${cpu} ${cpu} " org 256\n l r0,>127" 1330 "address displacement -129 outside [-128,127] (PC base 0x100)" 4 7)
    check_bytes(memory_original_${cpu} ${cpu} " l r2,0\n l r2,255\n l r2,-128(ic)\n l r2,127(ic)\n l r2,10(x0)\n l r2,(10)(x1)\n l r2,(10(ic))" "c200c2ffca80ca7fe20afa0ada0a")
endforeach()
check_diagnostic(double_register MN1613ALT " ad dr1,(r1)" 1445 "operand must be DR0" 3 5)
check_diagnostic(carry MN1613ALT " ad dr0,(r1),bad,skp" 1445 "operand must be C / 0 / 1" 3 14)
check_diagnostic(write_base MN1613ALT " setb r0,csbr" 1445 "operand must be SSBR / TSR0 / TSR1 / OSR0 / OSR1 / OSR2 / OSR3" 3 10)
check_diagnostic(special_register MN1613ALT " cpys r0,bad" 1445 "operand must be SBRB / ICB / NPP" 3 10)
check_diagnostic(read_hardware MN1613ALT " cpyh r0,sor" 1445 "operand must be TCR / TIR / TSR / SCR / SSR / SIR / IISR" 3 10)
check_diagnostic(write_hardware MN1613ALT " seth r0,sir" 1445 "operand must be TCR / TIR / TSR / SCR / SSR / SOR / IISR" 3 10)
check_diagnostic(segment_register MN1613ALT " ld r0,bad,0" 1962 "operand must be CSBR / SSBR / TSR0 / TSR1" 3 8)
check_diagnostic(indirect_increment MN1613ALT " mvwr r0,(r1)+" 1350 "allowed addressing forms: (R1) / (R2) / (R3) / (R4) / (X0) / (X1)" 3 10)
check_diagnostic(indirect_general MN1613ALT " lr r0,(sp)" 1350 "-(R1)" 3 8)
check_diagnostic(block_source MN1613ALT " blk (r1),(r1),r0" 1350 "allowed addressing forms: (R2)" 3 6)
check_diagnostic(block_destination MN1613ALT " blk (r2),(r2),r0" 1350 "allowed addressing forms: (R1)" 3 11)
check_diagnostic(long_indirect MN1613ALT " bl 100" 1350 "allowed addressing forms: (address)" 3 5)
foreach(base CSBR SSBR TSR0 TSR1)
    check_diagnostic(segment_offset_${base} MN1613ALT " ld r0,${base},65536" 110 "address 0x10000 gives segment offset 0x10000 outside [0,0xFFFF] with ${base}=0 (base 0x0)" 3 13 0)
endforeach()
check_bytes(registers_original MN1613ALT " mv r0,str\n sl r1,re,skp\n lr r0,(r1)+\n lr r0,-(r4)\n mvwr r0,(r2)\n blk (r2),(r1),r0" "780e211d20c020837f093f17")
check_bytes(tables_original MN1613ALT " cpyb r0,osr3\n setb r0,ssbr\n cpys r0,icb\n cpyh r0,sir\n seth r0,sor" "0ff00f100f983fd03f50")
