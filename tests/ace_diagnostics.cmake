file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_diagnostic(duplicate_index ACE1202 " ld a,[x,x]" 1350 "index register X occurs more than once in the address" 3 10)
check_diagnostic(duplicate_expression ACE1202 " ld a,[x,1,2]" 1350 "indexed address allows at most one displacement expression" 3 12)
check_diagnostic(duplicate_primary ACE1202 " clr [x,x]" 1350 "index register X occurs more than once in the address" 3 9)
check_diagnostic(missing_bracket ACE1202 " ld a,[x" 1300 "unclosed bracket '['; expected ']' before end of input" 3 7)
check_diagnostic(mismatched_bracket ACE1202 " ld a,[x)" 1300 "mismatched closing bracket ')'; expected ']'" 3 9)
foreach(cpu ACE1101 ACE1202)
    check_diagnostic(upper_${cpu} ${cpu} " jp 33" 1370 "branch displacement 32 outside [-31,31] (PC base 0x1)" 3 5)
    check_diagnostic(lower_${cpu} ${cpu} " org 31\n jp 0" 1370 "branch displacement -32 outside [-31,31] (PC base 0x20)" 4 5)
    check_diagnostic(dest_${cpu} ${cpu} " add x,#1" 1350 "allowed addressing forms: A" 3 6)
    check_bytes(upper_edge_${cpu} ${cpu} " jp 32" "ff")
    check_bytes(lower_edge_${cpu} ${cpu} " org 30\n jp 0" "df")
endforeach()
check_diagnostic(source ACE1202 " add a,x" 1350 "allowed addressing forms: [X], [0], [X,disp], [disp,X], [disp] (disp=1..255), expr, #expr" 3 8)
check_diagnostic(source1101 ACE1101 " add a,x" 1350 "allowed addressing forms: [X], [0], expr, #expr" 3 8)
check_diagnostic(indirect_eval_primary ACE1202 " clr [x,256]" 1320 "256 > 255" 3 9)
check_diagnostic(undefined ACE1202 " jp missing" 1010 "symbol undefined" 3 5)
check_bytes(original ACE1202 " ld a,#255\n ld a,[x]\n ld a,[x,1]\n ld a,[1,x]\n ld a,[1]\n ld a,[0]\n ld x,#4095\n jp 40" "51ff0e5201520152010e25ff0ffa")
check_bytes(forward ACE1202 " jp target\n nop\ntarget: nop" "e11c1c")
check_diagnostic(quoted_missing ACE1202 " ld a,[x,']'" 1300 "unclosed bracket '['; expected ']' before end of input" 3 7)
check_diagnostic(indirect_undefined ACE1202 " ld a,[x,missing]" 1010 "symbol undefined" 3 10)
check_bytes(quoted_brackets ACE1202 " ld a,[x,'(']\n ld a,[x,']']" "5228525d")
