    check_diagnostic(xmit_length_${cpu} ${cpu} "src liv 0,0,3\n xmit 1,src,2" 1131 "operand src has length 3 bits; selected length 2 bits" 4 9)
    check_diagnostic(arith_source_length_${cpu} ${cpu} "src liv 0,0,3\n move src,2,r1" 1131 "operand src has length 3 bits; selected length 2 bits" 4 7)
    check_diagnostic(arith_dest_length_${cpu} ${cpu} "dst liv 0,0,3\n move r1,2,dst" 1131 "operand dst has length 3 bits; selected length 2 bits" 4 12)
    check_diagnostic(arith_auto_length_${cpu} ${cpu} "src liv 0,0,3\ndst liv 0,0,2\n move src,dst" 1131 "operand src has length 3 bits; selected length 2 bits" 5 7)
    check_diagnostic(xec_length_${cpu} ${cpu} "src liv 0,0,3\n xec 0(src),2" 1131 "operand src has length 3 bits; selected length 2 bits" 4 8)
    check_diagnostic(nzt_length_${cpu} ${cpu} "src liv 0,0,3\n nzt src,2,0" 1131 "operand src has length 3 bits; selected length 2 bits" 4 6)
    check_diagnostic(eight_bits_${cpu} ${cpu} "src liv 0,0,8\n xmit 1,src,7" 1131 "operand src has length 8 bits; selected length 7 bits" 4 9)
    check_diagnostic(source_io_${cpu} ${cpu} " move r1,3,r2" 1445 "operand must be LIV0..LIV7 / RIV0..RIV7 / R20..R37 / IV expression" 3 7)
    if(cpu STREQUAL "8x300")
        set(core_forms "R0..R11 / R17 / AUX / OVF / IVL / IVR")
    else()
        set(core_forms "R0..R17 / AUX / OVF / IVL / IVR")
    endif()
    check_diagnostic(rotation_register_${cpu} ${cpu} " move liv0(1),r1" 1445 "operand must be ${core_forms}" 3 7)
    check_diagnostic(xec_form_${cpu} ${cpu} " xec 1" 1350 "allowed addressing forms: expression(register); expression(IV),length" 3 6)
    check_diagnostic(length_lower_${cpu} ${cpu} " xmit 1,liv0,0" 1315 "0 < 1" 3 14)
    check_diagnostic(length_upper_${cpu} ${cpu} " xmit 1,liv0,9" 1320 "9 > 8" 3 14)
