# RX immediate MOV uses five scaled displacement bits only when they fit.
set(source " cpu RXV1\n")
set(forward " cpu RXV1\n")
set(definitions "")
set(index 0)
foreach(case IN ITEMS B:0 B:31 B:32 B:255 B:256 W:0 W:62 W:64 W:512 L:0 L:124 L:128 L:1024)
    string(REPLACE ":" ";" fields "${case}")
    list(GET fields 0 size)
    list(GET fields 1 displacement)
    string(APPEND source " MOV.${size} #1,${displacement}[R1]\n")
    string(APPEND forward " MOV.${size} #immediate,disp${index}[R1]\n")
    string(APPEND definitions "disp${index} equ ${displacement}\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${TEST_DIR}/rx-mov.asm" "${source}")
file(WRITE "${TEST_DIR}/rx-mov-forward.asm" "${forward}immediate equ 1\n${definitions}")
check_asl(0 rx-mov.asm)
check_asl(0 rx-mov-forward.asm)
read_binary(rx-mov actual)
read_binary(rx-mov-forward resolved)
set(expected "3c10013c9f01f9142001f914ff01fa140001013d10013d9f01f9152001fa150001013e10013e9f01f9162001fa16000101")
if(NOT actual STREQUAL expected OR NOT resolved STREQUAL expected)
    message(FATAL_ERROR "RX immediate MOV displacement encoding: ${actual}, forward ${resolved}, expected ${expected}")
endif()
foreach(case IN ITEMS W:1 L:1 L:2 L:3)
    string(REPLACE ":" ";" fields "${case}")
    list(GET fields 0 size)
    list(GET fields 1 displacement)
    file(WRITE "${TEST_DIR}/rx-misaligned.asm" " cpu RXV1\n MOV.${size} #1,${displacement}[R1]\n")
    check_asl(2 rx-misaligned.asm)
endforeach()
