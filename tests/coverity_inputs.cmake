function(read_binary name result)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}" base)
    check_exit(0 "${P2BIN_PROGRAM}" -l 0 -r 0x-0x "${base}")
    file(READ "${TEST_DIR}/${name}.bin" bytes HEX)
    set(${result} "${bytes}" PARENT_SCOPE)
endfunction()

# PC-relative emulated double-operand instructions must use the same address
# for both operands, including offsets crossing zero and bit 15 on MSP430X.
foreach(extended IN ITEMS FALSE TRUE)
    if(extended)
        set(suffix X)
        set(pc_distance 4)
        set(offsets 0 1 2 -1 -2 -524286 524287 32768 32769 1048575)
        set(overflow -524288 -524287)
    else()
        set(suffix "")
        set(pc_distance 2)
        set(offsets 0 1 2 -1 -2 -32766 32767 65535)
        set(overflow -32768 -32767)
    endif()
    set(emulated " cpu MSP430X\n")
    set(expanded " cpu MSP430X\n")
    foreach(offset IN LISTS offsets)
        math(EXPR destination "${offset} - 2")
        foreach(op IN ITEMS ADD ADDC)
            if(op STREQUAL ADD)
                set(pseudo RLA)
            else()
                set(pseudo RLC)
            endif()
            string(APPEND emulated " ${pseudo}${suffix}.W ${offset}(PC)\n")
            if(offset EQUAL 0)
                # Symbolic syntax keeps the zero source displacement indexed;
                # literal 0(PC) is otherwise shortened to indirect mode.
                string(APPEND expanded " ${op}${suffix}.W $+${pc_distance},$+${pc_distance}\n")
            else()
                string(APPEND expanded " ${op}${suffix}.W ${offset}(PC),${destination}(PC)\n")
            endif()
        endforeach()
    endforeach()
    file(WRITE "${TEST_DIR}/msp-emulated${suffix}.asm" "${emulated}")
    file(WRITE "${TEST_DIR}/msp-expanded${suffix}.asm" "${expanded}")
    check_asl(0 msp-emulated${suffix}.asm)
    check_asl(0 msp-expanded${suffix}.asm)
    read_binary(msp-emulated${suffix} actual)
    read_binary(msp-expanded${suffix} expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "MSP430${suffix} PC displacement adjustment: ${actual} vs ${expected}")
    endif()
    set(source " cpu MSP430X\n")
    foreach(offset IN LISTS overflow)
        string(APPEND source " expect 1330\n RLA${suffix}.W ${offset}(PC)\n endexpect\n")
    endforeach()
    file(WRITE "${TEST_DIR}/msp-overflow${suffix}.asm" "${source}")
    check_asl(0 msp-overflow${suffix}.asm)
endforeach()

