foreach(length 8193 65535)
    file(TO_NATIVE_PATH "${TEST_DIR}/boundary-${length}.p" input)
    file(TO_NATIVE_PATH "${TEST_DIR}/bound-${length}.p" bound)
    file(TO_NATIVE_PATH "${TEST_DIR}/linked-${length}.p" linked)
    file(TO_NATIVE_PATH "${TEST_DIR}/bound-${length}.bin" binary)
    check_exit(0 "${TEST_PROGRAM}" object "${length}" "${input}")
    check_exit(0 "${PBIND_PROGRAM}" "${input}" "${bound}")
    check_exit(0 "${ALINK_PROGRAM}" "${input}" "${linked}")
    check_exit(0 "${P2BIN_PROGRAM}" -r 0x-0x "${bound}" "${binary}")
    file(READ "${TEST_DIR}/bound-${length}.bin" actual HEX)
    set(expected "")
    foreach(byte RANGE 0 255)
        math(EXPR hex "${byte}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${hex}" 2 -1 hex)
        if(byte LESS 16)
            set(hex "0${hex}")
        endif()
        string(APPEND pattern "${hex}")
    endforeach()
    math(EXPR blocks "${length} / 256")
    string(REPEAT "${pattern}" ${blocks} expected)
    math(EXPR tail "(${length} % 256) * 2")
    string(SUBSTRING "${pattern}" 0 ${tail} remainder)
    string(APPEND expected "${remainder}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "pbind changed the ${length}-byte payload")
    endif()
    set(pattern "")
    check_exit(0 "${P2BIN_PROGRAM}" -r 0x-0x "${linked}" "${binary}")
    file(READ "${TEST_DIR}/bound-${length}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "alink changed the ${length}-byte payload")
    endif()
endforeach()
foreach(case reloc-empty reloc-truncated reloc-undefined gran-zero)
    file(TO_NATIVE_PATH "${TEST_DIR}/${case}.p" input)
    file(TO_NATIVE_PATH "${TEST_DIR}/${case}-out.p" output)
    check_exit(0 "${TEST_PROGRAM}" object "${case}" "${input}")
    if(case STREQUAL "reloc-empty")
        check_exit(0 "${ALINK_PROGRAM}" "${input}" "${output}")
    elseif(case STREQUAL "reloc-truncated")
        check_exit(3 "${ALINK_PROGRAM}" "${input}" "${output}")
    elseif(case STREQUAL "reloc-undefined")
        check_exit(1 "${ALINK_PROGRAM}" "${input}" "${output}")
    else()
        check_exit(3 "${P2BIN_PROGRAM}" "${input}")
        check_exit(3 "${P2HEX_PROGRAM}" "${input}")
        check_exit(3 "${ALINK_PROGRAM}" "${input}" "${output}")
    endif()
endforeach()

