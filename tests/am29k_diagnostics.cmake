file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(cpu AM29245 AM29243 AM29240 AM29000)
    check_diagnostic(indirect_${cpu} ${cpu} " jmpi 0" 1350 "allowed addressing forms: R0..R255, GR0..GR127, LR0..LR127" 3 7)
    check_diagnostic(range_${cpu} ${cpu} " jmp 0x400000" 1370 "absolute branch address 4194304 outside [0,4194303]; must be a multiple of 4; branch displacement 4194304 outside [-131072,131071] (PC base 0x0)" 3 6)
    check_diagnostic(alignment_${cpu} ${cpu} " jmp 1" 1325 "absolute branch address 1 must be a multiple of 4" 3 6)
endforeach()
foreach(op CALLI JMPFI JMPFDECI JMPTI)
    string(LENGTH "${op}" length)
    math(EXPR column "${length}+7")
    check_diagnostic(indirect_${op} AM29000 " ${op} gr1,0" 1350 "allowed addressing forms: R0..R255, GR0..GR127, LR0..LR127" 3 "${column}")
endforeach()
check_diagnostic(unsigned_target AM29000 " org 0x40000\n jmp -4" 1370 "absolute branch address 4294967292 outside [0,4194303]; must be a multiple of 4; branch displacement -262148 outside [-131072,131071] (PC base 0x40000)" 4 6)
check_diagnostic(undefined AM29000 " jmp missing" 1010 "symbol undefined" 3 6)
check_bytes(original AM29000 " jmp gr1\n jmp 0\n jmp 0x40000\n jmp 0x3ffffc" "c0000001a0ff00ffa1000000a1ff00ff")
check_bytes(relative_high_target AM29000 " org 0x400000\n jmp 0x400004" "a0000001")
check_bytes(relative_wrapped_target AM29000 " jmp -4" "a0ff00ff")
check_bytes(forward AM29000 " jmp target\ntarget equ 4" "a0000001")
check_bytes(relative_lower AM29000 " org 0x20000\n jmp 0" "a0800000")
check_bytes(relative_upper AM29000 " jmp 0x1fffc" "a07f00ff")
