file(MAKE_DIRECTORY "${TEST_DIR}")

function(check_diagnostic name cpu body id detail line column)
    set(expected_result 2)
    set(kind error)
    if(ARGC GREATER 7)
        set(expected_result "${ARGV7}")
        set(kind warning)
    endif()
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    set(diagnostic "${output}${error}")
    string(FIND "${diagnostic}" "${detail}" detail_pos)
    if(column STREQUAL "")
        set(location "(${line}): ${kind} #${id}:")
    else()
        set(location "(${line}):${column}: ${kind} #${id}:")
    endif()
    string(FIND "${diagnostic}" "${location}" location_pos)
    string(REGEX MATCHALL "${kind} #[0-9]+:" errors "${diagnostic}")
    list(LENGTH errors error_count)
    if(NOT "${result}" STREQUAL "${expected_result}" OR detail_pos EQUAL -1
            OR location_pos EQUAL -1 OR NOT error_count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one #${id} at ${line}:${column}, ${detail}; got ${result}\n${diagnostic}")
    endif()
endfunction()

function(check_bytes name cpu body expected)
    file(WRITE "${TEST_DIR}/${name}.asm" " cpu ${cpu}\n org 0\n${body}\n")
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.asm" source)
    execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -q ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: assembly ${result}\n${output}${error}")
    endif()
    set(assembly_diagnostic "${output}${error}" PARENT_SCOPE)
    file(TO_NATIVE_PATH "${TEST_DIR}/${name}.p" object)
    execute_process(COMMAND ${TEST_EMULATOR} "${P2BIN_PROGRAM}" "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name}: conversion ${result}\n${output}${error}")
    endif()
    file(READ "${TEST_DIR}/${name}.bin" actual HEX)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

foreach(entry uPD546:1999 uPD547:999 uPD550:639 uPD552:999 uPD553:1999 uPD554:999 uPD556:1999 uPD557:1999 uPD650:1999 uPD651:999 uPD652:999)
    string(REPLACE ":" ";" parts "${entry}")
    list(GET parts 0 cpu)
    list(GET parts 1 maximum)
    math(EXPR bad "${maximum}+1")
    foreach(op JMP CAL JCP CZP)
        check_diagnostic(range_${cpu}_${op} ${cpu} " ${op} ${bad}" 1320 "${op} argument ${bad} outside [0,${maximum}]" 3 6)
    endforeach()
endforeach()
foreach(cpu uPD547 uPD550 uPD552 uPD554 uPD651 uPD652)
    foreach(op XC RAR INM DEM XHX XLY THX TLY XAZ XAW TAZ TAW XHR XLS TTM EI DI)
        check_diagnostic(family_${cpu}_${op} ${cpu} " ${op}" 1500 "supported only by uCOM-43 or iso650" 3 2)
    endforeach()
    foreach(op SFB RFB FBT FBF STM)
        check_diagnostic(imm_family_${cpu}_${op} ${cpu} " ${op} 1" 1500 "supported only by uCOM-43 or iso650" 3 2)
    endforeach()
endforeach()
foreach(op JTB NAA)
    check_diagnostic(iso_${op} uPD546 " ${op}" 1500 "supported only by iso650" 3 2)
endforeach()
check_diagnostic(family_first uPD550 " stm missing" 1500 "supported only by uCOM-43 or iso650" 3 2)
check_diagnostic(undefined uPD546 " jmp missing" 1010 "symbol undefined" 3 6)
check_bytes(uc43 uPD546 " xc\n sfb 3\n stm 63\n jmp 1999\n cal 0" "1a7f14bfa7cfa800")
check_bytes(iso iso650 " jtb\n naa\n jmp 4095\n cal 0" "1c451ca7ffa800")
check_bytes(forward uPD550 " jmp target\ntarget equ 639" "a27f")
set(ENV{LC_MESSAGES} de)
file(TO_NATIVE_PATH "${TEST_DIR}/family_first.asm" source)
execute_process(COMMAND ${TEST_EMULATOR} "${ASL_PROGRAM}" "${source}" -n -q -x
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
string(FIND "${output}${error}" "nur von uCOM-43 oder iso650" detail_pos)
if(NOT "${result}" STREQUAL "2" OR detail_pos EQUAL -1)
    message(FATAL_ERROR "German family: ${result}\n${output}${error}")
endif()
