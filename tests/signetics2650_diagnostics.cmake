foreach(op ADDZ LODZ STRZ LODI LODA LODR BDRA)
    if(op STREQUAL "ADDZ" OR op STREQUAL "LODZ" OR op STREQUAL "STRZ")
        set(rest "")
    else()
        set(rest ",0")
    endif()
    if(op STREQUAL "STRZ")
        set(regs "R1..R3")
    else()
        set(regs "R0..R3")
    endif()
    check_diagnostic(register_${op} 2650 " ${op} r4${rest}" 1445 "operand must be ${regs}" 3 7)
endforeach()
